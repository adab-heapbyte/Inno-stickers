{{ 'section-media-content-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'media-content-slider.js' | asset_url }}" defer="defer"></script>

{% style %}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{% endstyle %}

{%- assign flip = false -%}
{%- if section.settings.content_position == 'right' -%}
  {%- assign flip = true -%}
{%- endif -%}

<div
  class="media-content color-{{ section.settings.color_scheme }} background media-content-{{ section.id }} section-{{ section.id }}-padding"
  id="MediaContentSlider-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-delay="{{ section.settings.autoplay_delay | times: 1000 }}"
  data-enable-auto-deley="{{ section.settings.enable_auto_deley }}"
>
  <div class="media-content__layout{% if flip %} media-content__layout--flip{% endif %}">
    <div class="media-content__content">
      <div>
        {%- if section.settings.inner_title != blank or section.settings.description != blank -%}
          <div class="media-content__section-header">
            {%- if section.settings.inner_title != blank -%}
              {% assign heading_tag = section.settings.inner_heading_tag %}
              <{{ heading_tag | default: 'h3' }} class="media-content__section-title {{ section.settings.inner_heading_size }}">
                {{- section.settings.inner_title -}}
              </{{ heading_tag | default: 'h3' }}>
            {%- endif -%}
            {%- if section.settings.description != blank -%}
              <div class="media-content__section-description rte">
                {{- section.settings.description -}}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <nav class="media-content__nav" aria-label="Slide navigation">
          {%- for block in section.blocks -%}
            <div
              class="media-content__nav-item{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <button
                class="media-content__bullet{% if forloop.first %} is-active{% endif %}"
                data-index="{{ forloop.index0 }}"
                type="button"
                aria-label="Go to slide {{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <span class="media-content__bullet-rail">
                  <span class="media-content__bullet-fill"></span>
                </span>
              </button>

              <div class="media-content__nav-text">
                {%- if block.settings.title != blank -%}
                  <p class="media-content__slide-title {{ section.settings.slide_heading_size }}">
                    {{- block.settings.title -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="media-content__slide-desc rte">
                    {{- block.settings.description -}}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </nav>
      </div>
    </div>

    <div class="media-content__media">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_media_background = false
          if block.settings.background_image != blank or block.settings.background_color != blank
            assign has_media_background = true
          endif

          assign show_video_on_background = false
          if block.settings.video_overlay_on_image
            if block.settings.background_image != blank or block.settings.background_color != blank
              assign show_video_on_background = true
            endif
          endif

          assign show_image_on_color = false
          if block.settings.background_color != blank and block.settings.background_image != blank
            assign show_image_on_color = true
          endif
        -%}
        <div
          class="media-content__visual{% if forloop.first %} is-active{% endif %}{% if show_image_on_color %} media-content__visual--image-on-color{% endif %}"
          data-index="{{ forloop.index0 }}"
          data-video-duration="{% if block.settings.video != blank %}{{ block.settings.video.duration | default: 0 }}{% else %}0{% endif %}"
        >
          {%- if block.settings.background_color != blank -%}
            <span
              class="media-content__bg-color"
              style="background-color: {{ block.settings.background_color }};"
            ></span>
          {%- endif -%}
          {%- if block.settings.background_image != blank -%}
            {{
              block.settings.background_image
              | image_url: width: block.settings.background_image.width
              | image_tag:
                class: 'media-content__bg-img',
                loading: 'lazy',
                widths: '600, 900, 1200, 1600, 2000',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: block.settings.background_image.alt
              | escape
            }}
          {%- elsif block.settings.background_color == blank -%}
            <div class="media-content__bg-placeholder">
              {{- 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg media-content__placeholder' -}}
            </div>
          {%- endif -%}
          {%- if block.settings.overlay_opacity != 0 and has_media_background -%}
            <span
              class="media-content__overlay"
              style="opacity: {{ block.settings.overlay_opacity | times: 0.01 }};"
            ></span>
          {%- endif -%}

          {%- if block.settings.video != blank or block.settings.video_url != blank -%}
            {%- liquid
              assign vid_autoplay = block.settings.vid_autoplay
              assign vid_mute = block.settings.vid_mute
              assign vid_loop = block.settings.vid_loop
              assign vid_controls = block.settings.vid_controls

              if vid_autoplay == true
                assign p_autoplay = 1
              else
                assign p_autoplay = 0
              endif
              if vid_mute == true
                assign p_mute = 1
              else
                assign p_mute = 0
              endif
              if vid_loop == true
                assign p_loop = 1
              else
                assign p_loop = 0
              endif
              if vid_controls == true
                assign p_controls = 1
              else
                assign p_controls = 0
              endif
            -%}
            <div class="media-content__video-overlay{% if show_video_on_background %} media-content__video-overlay--on-image{% endif %}">
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag:
                    image_size: '800x',
                    autoplay: vid_autoplay,
                    loop: vid_loop,
                    muted: vid_mute,
                    playsinline: true,
                    controls: vid_controls,
                    class: 'media-content__video'
                }}
              {%- elsif block.settings.video_url != blank -%}
                {%- if block.settings.video_url.type == 'youtube' -%}
                  <iframe
                    class="media-content__video media-content__video--iframe"
                    src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay={{ p_autoplay }}&mute={{ p_mute }}&loop={{ p_loop }}&controls={{ p_controls }}&playlist={{ block.settings.video_url.id }}&rel=0&modestbranding=1&enablejsapi=1"
                    allow="autoplay; encrypted-media; fullscreen"
                    allowfullscreen
                    title="{{ block.settings.title | escape }}"
                  ></iframe>
                {%- elsif block.settings.video_url.type == 'vimeo' -%}
                  <iframe
                    class="media-content__video media-content__video--iframe"
                    src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay={{ p_autoplay }}&muted={{ p_mute }}&loop={{ p_loop }}&controls={{ p_controls }}&background={{ p_mute }}"
                    allow="autoplay; encrypted-media; fullscreen"
                    allowfullscreen
                    title="{{ block.settings.title | escape }}"
                  ></iframe>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
