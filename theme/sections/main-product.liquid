<script>
  (function () {
    let currentMode = null;
    const mq = window.matchMedia('(max-width: 749px)');

    function applyResponsiveClasses(force = false) {
      if (!force && !window.__mainProductDifferentGallery) {
        return;
      }
      const isMobile = mq.matches;
      const nextMode = isMobile ? 'mobile' : 'desktop';

      if (!force && currentMode === nextMode) return;

      currentMode = nextMode;

      const elements = document.querySelectorAll(`
				[data-main-product-section],
				[data-gallery-container],
				[data-main-info-content],
				[data-media-modal-content]
			`);

      if (!elements.length) return;

      elements.forEach((el) => {
        const mobileClasses = (el.dataset.mobileClass || '').trim().replace(/\s+/g, ' ');
        const desktopClasses = (el.dataset.desktopClass || '').trim().replace(/\s+/g, ' ');

        const mobileClass = mobileClasses?.split(' ') || [];
        const desktopClass = desktopClasses?.split(' ') || [];

        el.classList.remove(...mobileClass, ...desktopClass);
        el.classList.add(...(isMobile ? mobileClass : desktopClass));
      });
    }

    applyResponsiveClasses(true);

    const isDifferent =
      document.querySelector('[data-main-product-section]')?.dataset?.mainProductDifferentGallery === 'true';

    if (isDifferent) {
      applyResponsiveClasses(true);
    }

    mq.addEventListener('change', () => {
      if (isDifferent) applyResponsiveClasses();
    });

    document.addEventListener('shopify:section:load', function () {
      if (isDifferent) applyResponsiveClasses(true);
    });
  })();
</script>

{% javascript %}
  class ProductModal extends ModalDialog {
    constructor() {
      super();

      this.isProductPage = true;
      this.visibleMediaObserver = null;
      this.visibleMediaRatios = new Map();
      this.activeVisibleMedia = null;
    }

    hide() {
      this.teardownVisibleMediaAutoplay();
      super.hide(this.isProductPage);
      window.pauseAllMedia();
    }

    show(opener) {
      super.show(opener);
      this.showActiveMedia();
      this.setupVisibleMediaAutoplay();
    }

    showActiveMedia() {
      const activeMedia = this.querySelector(`[data-media-id="${this.openedBy.getAttribute('data-media-id')}"]`);
      if (activeMedia) {
        activeMedia.classList.add('active');
        activeMedia.scrollIntoView();
      }
      if (
        activeMedia?.nodeName == 'DEFERRED-MEDIA' &&
        activeMedia?.querySelector('template')?.content?.querySelector('.js-youtube')
      )
        activeMedia.loadContent();
    }

    isVideoAutoplayEnabled() {
      return this.dataset.enableVideoAutoplay === 'true';
    }

    setupVisibleMediaAutoplay() {
      this.teardownVisibleMediaAutoplay();

      if (!this.isVideoAutoplayEnabled()) return;

      const dialog = this.querySelector('.product-media-modal__dialog');
      const mediaItems = Array.from(this.querySelectorAll('.product-media-modal__item')).filter((item) =>
        item.querySelector('deferred-media')
      );

      if (!dialog || !mediaItems.length) return;

      this.visibleMediaObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            this.visibleMediaRatios.set(entry.target, entry.isIntersecting ? entry.intersectionRatio : 0);
          });

          this.syncVisibleMediaPlayback();
        },
        {
          root: dialog,
          threshold: [0, 0.35, 0.6, 0.85],
        }
      );

      mediaItems.forEach((item) => {
        this.visibleMediaRatios.set(item, 0);
        this.visibleMediaObserver.observe(item);
      });

      requestAnimationFrame(() => this.syncVisibleMediaPlayback());
    }

    syncVisibleMediaPlayback() {
      if (!this.isVideoAutoplayEnabled()) return;

      let nextActiveMedia = null;
      let maxRatio = 0;

      this.visibleMediaRatios.forEach((ratio, item) => {
        if (ratio > maxRatio) {
          maxRatio = ratio;
          nextActiveMedia = item;
        }
      });

      if (maxRatio < 0.35) {
        nextActiveMedia = null;
      }

      if (this.activeVisibleMedia === nextActiveMedia) return;

      window.pauseAllMedia();
      this.activeVisibleMedia = nextActiveMedia;

      if (!nextActiveMedia) return;

      const deferredMedia = nextActiveMedia.querySelector('deferred-media');
      if (deferredMedia) {
        window.playMedia(deferredMedia);
      }
    }

    teardownVisibleMediaAutoplay() {
      this.visibleMediaObserver?.disconnect();
      this.visibleMediaObserver = null;
      this.visibleMediaRatios.clear();
      this.activeVisibleMedia = null;
    }
  }

  customElements.define('product-modal', ProductModal);
{% endjavascript %}

