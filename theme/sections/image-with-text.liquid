{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

<script src="{{ 'image-with-text.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{% assign media_size = section.settings.height %}
{% assign layout = section.settings.layout %}

{% liquid
  if section.settings.image != blank and section.settings.mobile_image == blank
    assign image = section.settings.image
  elsif section.settings.image == blank and section.settings.mobile_image != blank
    assign image = section.settings.mobile_image
  elsif section.settings.image != blank and section.settings.mobile_image != blank
    assign image = 1
  else
    assign image = 0
  endif
%}

<div class="image-with-text section-{{ section.id }} background color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="image-with-text__container image-with-text__container--{{ section.settings.aspect_ratio }}">
      {% assign heading_pos = section.settings.heading_position %}
      {% assign image_width = section.settings.image_width %}
      <div class="image-with-text__grid{% if layout == 'image_right' or layout == 'image_bottom' %} image-with-text__grid--reverse{% endif %} image-with-text__grid--heading-{{ heading_pos }} image-with-text__grid--{{ layout }}{% if section.settings.layout_symmetry == 'symmetrical' %} image-with-text__grid--split-{{ section.settings.column_split }} image-with-text__grid--content-{{section.settings.content_position}}{% endif %}">
        <div class="image-with-text__left image-with-text__left--{{ media_size }} image-with-text__left--{{ image_width }}">
          <div
            class="
              image-with-text__media image-with-text__media--{{ media_size }}{% if section.settings.image != blank %}{% else %} image-with-text__media--placeholder placeholder{% endif %}
              {% if section.settings.enable_animation %} observe-me{% endif %}
            "
            {%- if media_size == 'landscape' -%}
              style="padding-bottom: 70%;"
            {%- endif -%}
            {%- if media_size == 'portrait' -%}
              style="padding-bottom: 130%;"
            {%- endif -%}
            {%- if media_size == 'square' -%}
              style="padding-bottom: 100%;"
            {%- endif -%}
          >
            {%- if image != 0 -%}
              {% comment %}
                sizes: match the actual rendered slot per layout so the browser picks
                the right srcset entry. Top/bottom = full width. Symmetrical uses the
                column split ratio. Default side-by-side ≈ 45vw. Mobile is always
                full width minus container padding.
              {% endcomment %}
              {% capture sizes %}{% if layout == 'image_top' or layout == 'image_bottom' %}(min-width: 990px) calc(100vw - 10rem), calc(100vw - 20px){% elsif section.settings.layout_symmetry == 'symmetrical' %}{% if section.settings.column_split == '30-70' %}(min-width: 990px) 70vw, calc(100vw - 20px){% elsif section.settings.column_split == '40-60' %}(min-width: 990px) 60vw, calc(100vw - 20px){% else %}(min-width: 990px) 50vw, calc(100vw - 20px){% endif %}{% else %}(min-width: 990px) 45vw, calc(100vw - 20px){% endif %}{% endcapture %}

              {% comment %}
                widths: cover 1× and 2× (retina) for every breakpoint.
                small slot max ~400px CSS → 800px max; large slot max ~70vw of 1440px = ~2000px.
              {% endcomment %}
              {%- assign iwt_widths = '360, 535, 600, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3800' -%}

              {%- if image and image != 1 -%}
                {{
                  image
                  | image_url: width: image.width
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: iwt_widths,
                    width: image.width,
                    height: image.height
                }}
              {% elsif image == 1 %}
                {{
                  section.settings.image
                  | image_url: width: section.settings.image.width
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: iwt_widths,
                    width: section.settings.image.width,
                    height: section.settings.image.height,
                    class: 'image-with-text-desktop_image'
                }}
                {{
                  section.settings.mobile_image
                  | image_url: width: section.settings.mobile_image.width
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: iwt_widths,
                    width: section.settings.mobile_image.width,
                    height: section.settings.mobile_image.height,
                    class: 'image-with-text-mobile_image'
                }}
              {%- endif -%}
            {%- else -%}
              <div class="image-with-text-placeholder image-with-text-placeholder--{{ media_size }}">
                {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__info-wrapper">
          {% assign alignement = 'left' %}
          {% if layout == 'image_right' %}
            {% assign alignement = 'left' %}
          {% elsif heading_pos == 'shrink' %}
            {% if layout == 'image_right' %}
              {% assign alignement = 'left' %}
            {% elsif layout == 'image_bottom' %}
              {% assign alignement = 'left' %}
            {% else %}
              {% assign alignement = 'right' %}
            {% endif %}
          {% else %}
            {% assign alignement = 'right' %}
          {% endif %}

          <p class="subtitle {{ alignement }}">
            {%- if section.settings.subheading != blank and heading_pos == 'shrink' -%}
              {{ section.settings.subheading }}
            {%- endif -%}
          </p>
          <div class="image-with-text__content image-with-text__content--{{ section.settings.text_width }}">
            {%- if section.settings.subheading != blank and heading_pos != 'shrink' -%}
              <p class="subtitle">
                {{ section.settings.subheading }}
              </p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              {% assign heading_tag = section.settings.heading_tag %}
              <{{ heading_tag }} class="image-with-text__heading title--section {{ section.settings.heading_size }}">
                {{ section.settings.heading }}
              </{{ heading_tag }}>
            {%- endif -%}
            {% if section.settings.text != blank %}
              <div class="image-with-text__text">
                {{ section.settings.text }}
              </div>
            {% endif %}

            {%- if section.settings.button_label != blank -%}
              <a
                {% if section.settings.button_link != blank %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
                class="button image-with-text__button button--{{ section.settings.button_style }} focus-inset"
                {% if section.settings.button_link == blank %}
                  aria-disabled="true"
                {% endif %}
              >
                <span>{{- section.settings.button_label | escape -}}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "image-with-text-section spaced-section",
  "tag": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "layout_symmetry",
      "default": "default",
      "label": "t:sections.image-with-text.settings.layout_symmetry.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.image-with-text.settings.layout_symmetry.options__1.label"
        },
        {
          "value": "symmetrical",
          "label": "t:sections.image-with-text.settings.layout_symmetry.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_split",
      "options": [
        { "value": "50-50", "label": "t:sections.image-with-text.settings.column_split.options__1.label" },
        { "value": "40-60", "label": "t:sections.image-with-text.settings.column_split.options__2.label" },
        { "value": "30-70", "label": "t:sections.image-with-text.settings.column_split.options__3.label" }
      ],
      "default": "50-50",
      "label": "t:sections.image-with-text.settings.column_split.label",
      "visible_if": "{{ section.settings.layout_symmetry == 'symmetrical' }}"
    },
    {
      "type": "select",
      "label": "t:sections.image-with-text.settings.content_position.label",
      "id": "content_position",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-with-text.settings.content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.content_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.image-with-text.settings.content_position.options__3.label"
        }
      ],
      "visible_if": "{{ section.settings.layout_symmetry == 'symmetrical' }}"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:sections.image-with-text.settings.aspect_ratio.label",
      "default": "medium",
      "visible_if": "{{ section.settings.layout_symmetry == 'default' }}",
      "options": [
        {
          "value": "full",
          "label": "t:sections.image-with-text.settings.aspect_ratio.options__1.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.aspect_ratio.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.aspect_ratio.options__3.label"
        },
        {
          "value": "original",
          "label": "t:sections.overlay-group.all.settings.aspect_ratio.options__4.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_position",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "t:sections.all.content_position.options__2.label"
        },
        {
          "value": "shrink",
          "label": "t:sections.image-with-text.settings.heading_position.option__3.label"
        }
      ],
      "label": "t:sections.all.content_position.content_label"
    },
    {
      "type": "select",
      "id": "text_width",
      "visible_if": "{{ section.settings.layout_symmetry == 'default' }}",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.text_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.text_width.options__2.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.text_width.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.image-with-text.settings.heading.default",
      "label": "t:sections.image-with-text.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.all.heading.tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "div",
          "label": "div"
        },
        {
          "value": "p",
          "label": "p"
        },
        {
          "value": "span",
          "label": "span"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "t:sections.image-with-text.settings.text.default",
      "label": "t:sections.image-with-text.settings.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.animate_on_scroll.header"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "t:sections.all.animate_on_scroll.label_2",
      "default": true,
      "info": "t:sections.all.animate_on_scroll.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.image-with-text.settings.button_label.default",
      "label": "t:sections.all.button.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        },
        {
          "value": "simple",
          "label": "t:sections.all.button.button_style.options__4.label"
        }
      ],
      "default": "simple",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.header__image.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.all.image.mobile_image.label"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.all.image_width.options__1.label"
        },
        {
          "value": "large",
          "label": "t:sections.all.image_width.options__3.label"
        }
      ],
      "default": "large",
      "label": "t:sections.all.image_width.label"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.image_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.all.image_ratio.options__4.label"
        }
      ],
      "default": "portrait",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_left",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "image_right",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        },
        {
          "value": "image_top",
          "label": "t:sections.image-with-text.settings.layout.options__3.label"
        },
        {
          "value": "image_bottom",
          "label": "t:sections.image-with-text.settings.layout.options__4.label"
        }
      ],
      "default": "image_right",
      "label": "t:sections.image-with-text.settings.layout.label",
      "info": "t:sections.image-with-text.settings.layout.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-with-text.presets.name"
    }
  ]
}
{% endschema %}
