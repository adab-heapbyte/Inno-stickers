{{ 'section-banner-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{%- liquid
  assign blocks_count = section.blocks.size
  assign is_odd = blocks_count | modulo: 2

  if is_odd == 1
    assign wrapper_parity = 'odd'
  else
    assign wrapper_parity = 'even'
  endif
-%}

<div class="banner-grid section-{{ section.id }}-padding background color-{{ section.settings.color_scheme }}">
  <div class="container">
    {% render 'section-header', section_heading_tag: section.settings.heading_tag %}

    {%- if blocks_count > 0 -%}
      <div class="banner-grid__wrapper banner-grid__wrapper--count-{{ blocks_count }} banner-grid__wrapper--{{ wrapper_parity }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_index = forloop.index0
            assign has_image = block.settings.show_image
            assign is_image_background = false
            assign has_image_ratio = false

            if has_image and block.settings.background_type == 'image'
              assign is_image_background = true
            endif

            if has_image and block.settings.enable_image_ratio
              assign has_image_ratio = true
            endif

            assign card_classes = 'banner-grid-card color-' | append: block.settings.color_scheme
            if has_image
              assign card_classes = card_classes | append: ' banner-grid-card--with-image banner-grid-card--bg-' | append: block.settings.background_type
            endif
            if has_image_ratio
              assign card_classes = card_classes | append: ' banner-grid-card--ratio-' | append: block.settings.image_ratio
            endif
            if block.settings.link != blank
              assign card_classes = card_classes | append: ' banner-grid-card--linked'
            endif
          -%}

          <div
            class="{{ card_classes }}"
            {% if is_image_background and has_image_ratio == false and block.settings.image != blank %}
              style="--card-padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | round: 2 }}%;"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              {%- liquid
                assign link_label = block.settings.heading | strip_html | strip
                if link_label == blank
                  assign link_label = 'accessibility.link' | t
                endif
              -%}
              <a
                href="{{ block.settings.link }}"
                class="banner-grid-card__link focus-inset"
                aria-label="{{ link_label | escape }}{% if block.settings.open_in_new_tab %} - {{ 'accessibility.link_messages.new_window' | t }}{% endif %}"
                {% if block.settings.open_in_new_tab %}
                  target="_blank" rel="noopener noreferrer"
                {% endif %}
              ></a>
            {%- endif -%}

            <div class="banner-grid-card__inner banner-grid-card__inner--horizontal-{{ block.settings.horizontal_content_alignment }} banner-grid-card__inner--vertical-{{ block.settings.vertical_content_alignment }}">
              {%- if block.settings.subheading != blank -%}
                <p class="banner-grid-card__subheading subtitle">
                  {{- block.settings.subheading | escape -}}
                </p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                {%- assign card_heading_tag = block.settings.heading_tag | default: 'h3' -%}
                <{{ card_heading_tag }} class="banner-grid-card__heading {{ block.settings.heading_size }}">
                  {{- block.settings.heading -}}
                </{{ card_heading_tag }}>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="banner-grid-card__description">
                  {{- block.settings.description -}}
                </div>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <a
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    aria-disabled="true"
                  {% endif %}
                  class="banner-grid-card__button button button--{{ block.settings.button_style }} focus-inset"
                >
                  <span>{{- block.settings.button_label | escape -}}</span>
                </a>
              {%- endif -%}
            </div>

            {%- if has_image -%}
              <div class="banner-grid-card__media">
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign fetch_priority = 'auto'
                    assign image_loading = 'lazy'

                    # The grid is 2-up from $md, so only the first row can sit above the fold
                    if section.index == 1 and block_index < 2
                      assign image_loading = 'eager'
                      if block_index == 0
                        assign fetch_priority = 'high'
                      endif
                    endif
                  -%}

                  {%- capture media_sizes -%}
                    {%- if blocks_count >= 2 -%}
                      (min-width: 750px) calc((100vw - 48px) / 2),
                    {%- endif -%}
                    calc(100vw - 40px)
                  {%- endcapture -%}

                  {{
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag:
                      class: 'banner-grid-card__image',
                      loading: image_loading,
                      sizes: media_sizes,
                      widths: '360, 540, 720, 990, 1200, 1600, 2000, 2400, 2800, 3200',
                      fetchpriority: fetch_priority
                  }}
                {%- else -%}
                  {%- assign placeholder_index = block_index | modulo: 4 | plus: 1 -%}
                  {{
                    'collection-apparel-'
                    | append: placeholder_index
                    | placeholder_svg_tag: 'placeholder-svg banner-grid-card__image'
                  }}
                {%- endif -%}

                {%- if is_image_background and block.settings.overlay_opacity > 0 -%}
                  <span
                    class="banner-grid-card__overlay banner-grid-card__overlay--{{ block.settings.overlay_style }}"
                    style="opacity: {{ block.settings.overlay_opacity }};"
                    aria-hidden="true"
                  ></span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

