{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{%- if section.settings.banner_style == 'editorial' -%}
  {{ 'section-collection-hero-editorial.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{%- if section.settings.banner_style == 'editorial' -%}
  {%- liquid
    # Editorial layout (Figma PLP): desktop image then title + description;
    # mobile title + description first, then a square image.
    # Collections without an image show the title (and description) only.
    assign hero_image = collection.image
    if hero_image == blank and collection.id == blank
      assign hero_image = section.settings.image_products
    endif
    if section.settings.show_collection_image == false
      assign hero_image = blank
    endif
    assign hero_description = collection.description
  -%}
  <div class="collection-hero-editorial{% if hero_image == blank %} collection-hero-editorial--no-image{% endif %}">
    <div class="collection-hero-editorial__inner">
      {%- if hero_image != blank -%}
        <div class="collection-hero-editorial__media">
          {{
            hero_image
            | image_url: width: 3200
            | image_tag:
              class: 'collection-hero-editorial__image',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(min-width: 990px) calc(100vw - 2 * max(2.4rem, 8.33vw)), calc(100vw - 3.2rem)',
              widths: '375, 550, 750, 1100, 1500, 1800, 2200, 2800, 3200',
              alt: hero_image.alt | default: collection.title
          }}
        </div>
      {%- endif -%}
      <div class="collection-hero-editorial__text">
        <h1 class="collection-hero-editorial__title">
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {{- collection.title | escape -}}
        </h1>
        {%- if section.settings.show_description and hero_description != blank -%}
          <div class="collection-hero-editorial__description">{{ hero_description }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- else -%}
<div class="collection-hero">
  <div class="collection-hero__wrapper ">
    <div class="collection-hero__inner">
      {%- liquid
        assign collection_image = collection.image

        if collection_image == blank and collection.id == blank
          assign collection_image = section.settings.image_products
        endif
      -%}
      {%- if section.settings.show_collection_image and collection_image -%}
        {% capture sizes %}
          (min-width: 1100px) calc(100vw + 200px), 
          calc(100vw + 60px)
        {% endcapture %}
        <div class="collection-hero__image-wrapper">
          <div class="collection-hero__image-container media">
            {{
              collection_image
              | image_url: width: collection_image.width
              | image_tag:
                loading: 'lazy',
                widths: '360, 535, 720, 940, 1100, 1200, 1440, 1600, 1800, 2000, 2100, 2200, 2880, 3200, 3600, 4000, 4200, 4400',
                sizes: sizes
            }}
          </div>
        </div>
      {%- endif -%}
      <div class="container">
        <div class="collection-hero__text-wrapper">
          <h1 class="collection-hero__title title--page h2">
            <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
            {{- collection.title | escape -}}
          </h1>
        </div>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "collection-banner-section spaced-section--full-width section-template--overlay",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "select",
      "id": "banner_style",
      "label": "t:sections.main-collection-banner.settings.banner_style.label",
      "info": "t:sections.main-collection-banner.settings.banner_style.info",
      "options": [
        { "value": "default", "label": "t:sections.main-collection-banner.settings.banner_style.options__1.label" },
        { "value": "editorial", "label": "t:sections.main-collection-banner.settings.banner_style.options__2.label" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_description.label",
      "info": "t:sections.main-collection-banner.settings.show_description.info"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
    },
    {
      "type": "image_picker",
      "id": "image_products",
      "label": "t:sections.main-collection-banner.settings.image_products.label",
      "info": "t:sections.main-collection-banner.settings.image_products.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ]
}
{% endschema %}
