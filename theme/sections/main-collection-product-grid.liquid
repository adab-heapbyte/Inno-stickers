{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{%- if settings.pagination_type == 'load_more' or settings.pagination_type == 'infinite_scroll' -%}
  <script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<style>
  .facets-container {
    opacity: 0;
    animation: fadeIn 0.3s ease forwards;
    animation-delay: 100ms;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>

{{ 'component-card.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'component-price.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'component-badge.css' | asset_url | stylesheet_tag: preload: true }}
{{ 'component-rte.css' | asset_url | stylesheet_tag: preload: true }}

<noscript>{{ 'component-card.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-badge.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'products-per-row.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.enable_filtering
  or section.settings.enable_tag
  or section.settings.enable_sorting
  or section.settings.enable_per_row_button
-%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-grid.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if settings.quickview_show or settings.show_on_mobile or settings.type_color_swatch == 'custom' -%}
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{% if settings.on_hover == 'slider' %}
  <script
    src="{{ 'product-card-slider.js' | asset_url }}"
    defer="defer"
  ></script>
{% endif %}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{%- liquid
  # Card style "catalog" (Figma PLP): the home page Best Seller card (price suffix, rating,
  # "-x%" badge, Add Sample button). Other options keep the theme card.
  assign card_style = section.settings.card_style | default: 'classic'
  assign card_price_suffix = blank
  assign card_show_rating = false
  assign card_button_label = blank
  assign card_sale_badge_format = blank
  if card_style == 'catalog'
    assign card_price_suffix = section.settings.price_suffix
    assign card_show_rating = section.settings.show_rating
    assign card_button_label = section.settings.card_button_label
    assign card_sale_badge_format = 'percent_off'
  endif
  assign room_toggle = false
  if card_style == 'catalog' and section.settings.enable_room_toggle
    assign room_toggle = true
  endif
-%}
{%- if card_style == 'catalog' -%}
  {{ 'section-collection-catalog.css' | asset_url | stylesheet_tag }}
  {%- if room_toggle -%}
    <script src="{{ 'collection-room-toggle.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <script src="{{ 'collection-filter-sheet.js' | asset_url }}" defer="defer"></script>
  {%- if card_button_label != blank or section.settings.enable_sample_card -%}
    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
{%- endif -%}
{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign count = 0 -%}

{% liquid
  assign collection_description = collection.description
  if collection.id == blank
    assign collection_description = section.settings.description_products
  endif
%}

<div class="section-{{ section.id }}-padding container--{{ section.settings.filter_type }}">
  <div
    class="
      collection-wrapper
      collection-wrapper--vertical
      {% if card_style == 'catalog' %} collection-wrapper--catalog {% endif %}
      {%- if collection.all_products_count == 0 -%} collection-wrapper--empty {% endif %}
      {%- if section.settings.enable_filtering == false and section.settings.enable_sorting == false and section.settings.enable_per_row_button == false and section.settings.enable_tag == false -%} collection-wrapper_no-facets {% endif %}
    "
  >
    {%- assign show_toolbar = false -%}
    {%- if collection.all_products_count > 0 and collection.products_count > 0 -%}
      {%- assign show_toolbar = true -%}
    {%- elsif card_style == 'catalog' and collection.all_products_count > 0 -%}
      {%- comment -%} Catalog style keeps the toolbar when filters give no results (Figma) {%- endcomment -%}
      {%- assign show_toolbar = true -%}
    {%- endif -%}
    {%- if show_toolbar -%}
      {%- if section.settings.enable_filtering
        or section.settings.enable_tag
        or section.settings.enable_sorting
        or section.settings.enable_per_row_button
      -%}
        {% render 'facets',
          results: collection,
          enable_filtering: section.settings.enable_filtering,
          enable_tag: section.settings.enable_tag,
          enable_sorting: section.settings.enable_sorting,
          filter_type: section.settings.filter_type,
          enable_per_row_button: section.settings.enable_per_row_button,
          enable_row_count_control: section.settings.enable_row_count_control,
          image_filter_ratio: section.settings.image_filter_ratio,
          image_filter_fit: section.settings.image_filter_fit,
          image_filter_columns: section.settings.image_filter_columns,
          columns_mobile: section.settings.columns_mobile,
          is_sidebar: false
        %}
      {%- endif -%}
    {%- endif -%}
    {%- if section.settings.filter_type == 'sidebar' and collection.all_products_count > 0 and collection.products_count > 0 -%}
      {%- if section.settings.enable_filtering
        or section.settings.enable_tag
        or section.settings.enable_sorting
        or section.settings.enable_per_row_button
      -%}
        <div class="collection-sidebar">
          <div class="collection-sidebar__inner">
            {% render 'sidebar-facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_tag: section.settings.enable_tag,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              enable_per_row_button: section.settings.enable_per_row_button,
              enable_row_count_control: section.settings.enable_row_count_control,
              image_filter_ratio: section.settings.image_filter_ratio,
              image_filter_fit: section.settings.image_filter_fit,
              image_filter_columns: section.settings.image_filter_columns,
              columns_mobile: section.settings.columns_mobile,
              is_sidebar: true
            %}
          </div>
      {%- endif -%}
    {%- endif -%}
    <div
      data-productis-in-row="{{ section.settings.default_per_row }}"
      id="ProductGridContainer"
      class="
        products-grid container
        {% if card_style == 'catalog' %} collection-catalog {%- endif -%}
        {% if section.settings.enable_filtering == false %} products-grid_no-filter {%- endif -%}
        {% if section.settings.enable_row_count_control == true %} row-count-control {%- endif -%}
      "
    >
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size == 0 -%}
          <div
            class="collection collection-product collection--empty container"
            id="product-grid"
            data-id="{{ section.id }}"
          >
            <div class="loading-overlay">
              <div class="loading-overlay__spinner">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  role="presentation"
                  class="spinner"
                  viewBox="0 0 66 66"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </div>

            {%- if card_style == 'catalog' and collection.all_products_count > 0 -%}
              <div class="catalog-empty">
                <img class="catalog-empty__icon" src="{{ 'icon-empty-search.svg' | asset_url }}" alt="" width="52" height="52">
                <div class="catalog-empty__text">
                  <h2 class="catalog-empty__title">{{ 'products.facets.empty_title' | t }}</h2>
                  <p class="catalog-empty__description">{{ 'products.facets.empty_text' | t }}</p>
                </div>
                <facet-remove>
                  <a href="{{ collection.url }}" class="catalog-sheet__button catalog-sheet__button--outline catalog-empty__button">
                    {{- 'products.facets.clear_all_filters' | t -}}
                  </a>
                </facet-remove>
              </div>
            {%- else -%}
            <div class="title-wrapper center title-wrapper-empty">
              <h2 class="title title--primary">
                {% if collection.all_products_count == 0 %}
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                {% else %}
                  {{ 'sections.collection_template.empty_results' | t -}}
                  <br>
                  {{
                    'sections.collection_template.results_use_fewer_filters_html'
                    | t: link: collection.url, class: 'underlined-link link'
                  }}
                {% endif %}
              </h2>
            </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="collection collection-product {% if section.settings.show_collection_description and collection_description != blank %} section-{{ section.id }}-padding {% endif %} ">
            <div class="loading-overlay">
              <div class="loading-overlay__spinner">
                <svg
                  aria-hidden="true"
                  focusable="false"
                  role="presentation"
                  class="spinner"
                  viewBox="0 0 66 66"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </div>

            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                collection-product-list
                collection-product-list--{{ section.settings.products_to_show_row }}
                collection-product-list--{{ section.settings.columns_mobile }}-mobile load-more-grid
                collection-product-list--{{ section.settings.grid_space }}-mobile
              "
            >
              {%- liquid
                # "Order Sample Set" card (catalog style): page 1, no active filter,
                # kit available, and the collection is in the list (empty list = all).
                assign show_sample_card = false
                assign sample_product = section.settings.sample_card_product
                if card_style == 'catalog' and section.settings.enable_sample_card and sample_product != blank and sample_product.available and paginate.current_page == 1
                  assign show_sample_card = true
                  for filter in collection.filters
                    if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
                      assign show_sample_card = false
                    endif
                  endfor
                  if section.settings.sample_card_collections != blank
                    assign in_list = false
                    for listed in section.settings.sample_card_collections
                      if listed.id == collection.id
                        assign in_list = true
                      endif
                    endfor
                    if in_list == false
                      assign show_sample_card = false
                    endif
                  endif
                endif
                # Desktop: after product N (Figma: 6th tile). Mobile (2 columns): full
                # width after the last complete row before it (Figma: after product 4).
                assign sample_desktop_after = section.settings.sample_card_position | default: 5
                assign sample_mobile_after = sample_desktop_after | modulo: 2
                assign sample_mobile_after = sample_desktop_after | minus: sample_mobile_after
                if sample_mobile_after < 2
                  assign sample_mobile_after = 2
                endif
                assign sample_rendered_desktop = false
                assign sample_rendered_mobile = false
              -%}
              {%- for product in collection.products -%}
                {% if forloop.index == 1 and section.blocks[0].settings.image != blank %}
                  <li class="collection-product-promo-img media--{{ section.settings.image_ratio }} collection-product-promo-img-1 {% if section.blocks[0].settings.heading != blank or section.blocks[0].settings.description != blank  %} collection-product-promo-img-promo {% endif %}">
                    {{
                      section.blocks[0].settings.image
                      | image_url: width: section.blocks[0].settings.image.width
                      | image_tag:
                        loading: 'lazy',
                        width: section.blocks[0].settings.image.width,
                        sizes: '100vw',
                        widths: '550, 750, 1100, 1500, 1780, 2000, 3000, 3840, 4200, 5000'
                    }}
                    {% if section.blocks[0].settings.heading != blank
                      or section.blocks[0].settings.description != blank
                    %}
                      <div
                        class="collection-product-promo__overlay"
                        style="opacity: {{ section.blocks[0].settings.overlay_opacity }}"
                      ></div>
                      <div class="collection-product-promo-text color-{{ section.blocks[0].settings.color_scheme }}">
                        {%- if section.blocks[0].settings.heading != blank -%}
                          <h2 class="section-heading__heading {{ section.blocks[0].settings.heading_size }}">
                            {{ section.blocks[0].settings.heading }}
                          </h2>
                        {%- endif -%}
                        {%- if section.blocks[0].settings.description != blank -%}
                          <p class="section-heading__description">
                            {{ section.blocks[0].settings.description }}
                          </p>
                        {%- endif -%}
                      </div>
                    {% endif %}
                  </li>
                {% endif %}
                {% if forloop.index == 8 and section.blocks[1].settings.image != blank %}
                  <li class="collection-product-promo-img media--{{ section.settings.image_ratio }} collection-product-promo-img-2 {% if section.blocks[1].settings.heading != blank or section.blocks[1].settings.description != blank  %} collection-product-promo-img-promo {% endif %}">
                    {{
                      section.blocks[1].settings.image
                      | image_url: width: section.blocks[1].settings.image.width
                      | image_tag:
                        loading: 'lazy',
                        width: section.blocks[1].settings.image.width,
                        sizes: '100vw',
                        widths: '550, 750, 1100, 1500, 1780, 2000, 3000, 3840, 4200, 5000'
                    }}
                    {% if section.blocks[1].settings.heading != blank
                      or section.blocks[1].settings.description != blank
                    %}
                      <div
                        class="collection-product-promo__overlay"
                        style="opacity: {{ section.blocks[1].settings.overlay_opacity }}"
                      ></div>
                      <div class="collection-product-promo-text color-{{ section.blocks[1].settings.color_scheme }}">
                        {%- if section.blocks[1].settings.heading != blank -%}
                          <h2 class="section-heading__heading {{ section.blocks[1].settings.heading_size }}">
                            {{ section.blocks[1].settings.heading }}
                          </h2>
                        {%- endif -%}
                        {%- if section.blocks[1].settings.description != blank -%}
                          <p class="section-heading__description">
                            {{ section.blocks[1].settings.description }}
                          </p>
                        {%- endif -%}
                      </div>
                    {% endif %}
                  </li>
                {% endif %}
                {% if forloop.index == 16 and section.blocks[2].settings.image != blank %}
                  <li class="collection-product-promo-img media--{{ section.settings.image_ratio }} collection-product-promo-img-3{% if section.blocks[2].settings.heading != blank or section.blocks[2].settings.description != blank  %} collection-product-promo-img-promo {% endif %}">
                    {{
                      section.blocks[2].settings.image
                      | image_url: width: section.blocks[2].settings.image.width
                      | image_tag:
                        loading: 'lazy',
                        width: section.blocks[2].settings.image.width,
                        sizes: '100vw',
                        widths: '550, 750, 1100, 1500, 1780, 2000, 3000, 3840, 4200, 5000'
                    }}
                    {% if section.blocks[2].settings.heading != blank
                      or section.blocks[2].settings.description != blank
                    %}
                      <div
                        class="collection-product-promo__overlay"
                        style="opacity: {{ section.blocks[2].settings.overlay_opacity }}"
                      ></div>
                      <div class="collection-product-promo-text color-{{ section.blocks[2].settings.color_scheme }}">
                        {%- if section.blocks[2].settings.heading != blank -%}
                          <h2 class="section-heading__heading {{ section.blocks[2].settings.heading_size }}">
                            {{ section.blocks[2].settings.heading }}
                          </h2>
                        {%- endif -%}
                        {%- if section.blocks[2].settings.description != blank -%}
                          <p class="section-heading__description">
                            {{ section.blocks[2].settings.description }}
                          </p>
                        {%- endif -%}
                      </div>
                    {% endif %}
                  </li>
                {% endif %}
                {% if forloop.index == 24 and section.blocks[3].settings.image != blank %}
                  <li class="collection-product-promo-img media--{{ section.settings.image_ratio }} collection-product-promo-img-4{% if section.blocks[3].settings.heading != blank or section.blocks[3].settings.description != blank  %} collection-product-promo-img-promo {% endif %}">
                    {{
                      section.blocks[3].settings.image
                      | image_url: width: section.blocks[3].settings.image.width
                      | image_tag:
                        loading: 'lazy',
                        width: section.blocks[3].settings.image.width,
                        sizes: '100vw',
                        widths: '550, 750, 1100, 1500, 1780, 2000, 3000, 3840, 4200, 5000'
                    }}
                    {% if section.blocks[3].settings.heading != blank
                      or section.blocks[3].settings.description != blank
                    %}
                      <div
                        class="collection-product-promo__overlay"
                        style="opacity: {{ section.blocks[3].settings.overlay_opacity }}"
                      ></div>
                      <div class="collection-product-promo-text color-{{ section.blocks[3].settings.color_scheme }}">
                        {%- if section.blocks[3].settings.heading != blank -%}
                          <h2 class="section-heading__heading {{ section.blocks[3].settings.heading_size }}">
                            {{ section.blocks[3].settings.heading }}
                          </h2>
                        {%- endif -%}
                        {%- if section.blocks[3].settings.description != blank -%}
                          <p class="section-heading__description">
                            {{ section.blocks[3].settings.description }}
                          </p>
                        {%- endif -%}
                      </div>
                    {% endif %}
                  </li>
                {% endif %}
                <li class="collection-product-card {% if settings.on_hover == "hover" %}quickview--hover{% endif %}">
                  {% render 'product-card',
                    product_card_product: product,
                    media_size: section.settings.image_ratio,
                    media_fit: section.settings.image_fit,
                    show_vendor: section.settings.show_vendor,
                    show_color_count: section.settings.show_color_count,
                    show_size_count: section.settings.show_size_count,
                    show_collection: section.settings.show_collection,
                    show_desc: section.settings.show_desc,
                    section_id: section.id,
                    add_id: forloop.index,
                    columns_mobile: section.settings.columns_mobile,
                    show_linked_products: section.settings.enable_linked_products,
                    price_suffix: card_price_suffix,
                    show_rating: card_show_rating,
                    card_button_label: card_button_label,
                    sale_badge_format: card_sale_badge_format,
                    room_view_media: room_toggle
                  %}
                </li>
                {%- if show_sample_card -%}
                  {%- if forloop.index == sample_mobile_after -%}
                    {% render 'collection-sample-card', product: sample_product, section: section, placement: 'mobile' %}
                    {%- assign sample_rendered_mobile = true -%}
                  {%- endif -%}
                  {%- if forloop.index == sample_desktop_after -%}
                    {% render 'collection-sample-card', product: sample_product, section: section, placement: 'desktop' %}
                    {%- assign sample_rendered_desktop = true -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if show_sample_card -%}
                {%- if sample_rendered_desktop == false and sample_rendered_mobile == false -%}
                  {% render 'collection-sample-card', product: sample_product, section: section, placement: 'both' %}
                {%- elsif sample_rendered_desktop == false -%}
                  {% render 'collection-sample-card', product: sample_product, section: section, placement: 'desktop' %}
                {%- elsif sample_rendered_mobile == false -%}
                  {% render 'collection-sample-card', product: sample_product, section: section, placement: 'mobile' %}
                {%- endif -%}
              {%- endif -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {%- if settings.pagination_type == 'load_more' -%}
                {% render 'load-more',
                  next_url: paginate.next.url,
                  count_pages: paginate.pages,
                  current_page: paginate.current_page
                %}
                <div class="js-hidden">
                  {% render 'pagination', paginate: paginate %}
                </div>
              {%- elsif settings.pagination_type == 'infinite_scroll' -%}
                {% render 'infinite-scroll',
                  next_url: paginate.next.url,
                  count_pages: paginate.pages,
                  current_page: paginate.current_page
                %}
                <div class="js-hidden">
                  {% render 'pagination', paginate: paginate %}
                </div>
              {% else %}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
      {%- if section.settings.show_collection_description and collection_description != blank -%}
        <div class="collection-hero__description rte {% if settings.rte_type == 'custom' %}rte-container{% endif %}">
          {{ collection_description }}
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.filter_type == 'sidebar' and collection.all_products_count > 0 and collection.products_count > 0 -%}
      {%- if section.settings.enable_filtering
        or section.settings.enable_tag
        or section.settings.enable_sorting
        or section.settings.enable_per_row_button
      -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "tag": "section",
  "class": "collection-grid-section",
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.main-collection-product-grid.settings.promo_block.name",
      "limit": 4,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main-collection-product-grid.settings.promo_block.content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "info": "t:sections.main-collection-product-grid.settings.promo_block.info",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h3",
              "label": "t:sections.all.heading_size.options__3.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "t:sections.all.text.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "default": "background-2",
          "label": "t:sections.all.text_color_scheme.label"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "default": 0.1,
          "label": "t:sections.all.overlay_opacity.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.main-collection-product-grid.settings.card_style.label",
      "info": "t:sections.main-collection-product-grid.settings.card_style.info",
      "options": [
        { "value": "classic", "label": "t:sections.main-collection-product-grid.settings.card_style.options__1.label" },
        { "value": "catalog", "label": "t:sections.main-collection-product-grid.settings.card_style.options__2.label" }
      ],
      "default": "classic"
    },
    {
      "type": "text",
      "id": "price_suffix",
      "label": "t:sections.main-collection-product-grid.settings.price_suffix.label",
      "info": "t:sections.main-collection-product-grid.settings.price_suffix.info"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "enable_room_toggle",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.enable_room_toggle.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_room_toggle.info"
    },
    {
      "type": "text",
      "id": "card_button_label",
