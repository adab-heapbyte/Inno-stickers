{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
<script src="{{ 'multicolumn.js' | asset_url }}" defer="defer"></script>

{% style %}
  {% render 'section-margin' %}

  .next::after {
  	content: "{{ 'product-carousel.next' | t }}";
  }

  .prev::after {
  	content: "{{ 'product-carousel.previous' | t }}";
  }
{% endstyle %}

{% liquid
  assign section_id = 'shopify-section-' | append: section.id
  assign slideshow_speed = section.settings.slideshow_speed
  assign autoplay = true
  assign navigation = section.settings.navigation
  assign stop_autoplay = section.settings.stop_autoplay
  assign per_row = section.settings.multicolumn_to_show
  assign show_two_cards = section.settings.show_two_cards
  assign mobile = 1
  assign layout_type = section.settings.layout_type
  assign swiper = section.settings.swiper
  if show_two_cards
    assign mobile = 2
  endif
%}

<div class="multicolumn multicolumn--layout-{{ layout_type }} background color-background-1 section-{{ section.id }}-padding multicolumn--heading-align-{{ section.settings.heading_alignment }} multicolumn--heading-width-{{ section.settings.heading_content_width }}"
  {%- if layout_type == 'badges' %} style="--badge-columns: {{ section.blocks.size | at_least: 1 | at_most: 4 }};"{% endif %}
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      {% render 'section-header', section_heading_tag: section.settings.heading_tag %}
    {% endif %}
  </div>
  <div
    class="multicolumn__wrapper{% if swiper %} multicolumn-slider {% endif %}{% if section.settings.enable_full_screen == false %} container{%  endif %} {% if navigation and swiper %} multicolumn-cursor{%  endif %}"
    data-id="{{ section_id }}"
    data-speed="{{ slideshow_speed }}"
    data-autoplay="{{ autoplay }}"
    data-navigation="{{ navigation }}"
    data-stop-autoplay="{{ stop_autoplay }}"
    data-per-row="{{ per_row }}"
    data-mobile="{{ mobile }}"
  >
    <div class="multicolumn-list multicolumn-list--{{ section.settings.content_position }} swiper">
      <div
        class="
          multicolumn-list__wrapper swiper-wrapper multicolumn-list__wrapper--{{ layout_type }}
          multicolumn-list__wrapper--{{ section.settings.multicolumn_to_show }} multicolumn-list__wrapper--static {% if layout_type == "overlay" and swiper == false %} multicolumn-list__wrapper--gap{% endif %}
          {% if section.settings.enable_scroll == true and swiper == false%} {{ section.settings.grid_space }}--grid-space multicolumn-list__wrapper--scroll{% endif %}
        "
      >
        {%- for block in section.blocks -%}
          {% assign block_index = forloop.index0 | modulo: 3 | plus: 1 %}
          {% assign is_column_linked = false %}
          {% if block.settings.column_link != blank %}
            {% assign is_column_linked = true %}
          {% endif %}
          <div
            class="multicolumn-card multicolumn-list__item swiper-slide color-{{ section.settings.color_scheme }} multicolumn-card--{{ section.settings.on_hover }} {% if section.settings.always_visible_text == true and layout_type == "overlay" %}multicolumn-card--always-visible-text{% endif %}{% if is_column_linked %} multicolumn-card--linked{% endif %}"
            {% if is_column_linked %}data-column-link="{{ block.settings.column_link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {% assign image_placeholder = 'hero-apparel-' | append: block_index %}

            {%- liquid
              assign vid_autoplay = block.settings.vid_autoplay
              assign vid_mute = block.settings.vid_mute
              assign vid_loop = block.settings.vid_loop
              assign vid_controls = block.settings.vid_controls
              if vid_autoplay == true
                assign p_autoplay = 1
              else
                assign p_autoplay = 0
              endif
              if vid_mute == true
                assign p_mute = 1
              else
                assign p_mute = 0
              endif
              if vid_loop == true
                assign p_loop = 1
              else
                assign p_loop = 0
              endif
              if vid_controls == true
                assign p_controls = 1
              else
                assign p_controls = 0
              endif
              assign video_overlay = false
              if block.settings.video_overlay_on_image
                if block.settings.video != blank or block.settings.video_url != blank
                  assign video_overlay = true
                endif
              endif
            -%}
            {%- comment -%}
              Compute sizes based on actual columns shown per row and mobile setting,
              so the browser picks the right srcset entry on every screen size.
              Mobile is 1 column by default, 2 columns when show_two_cards is enabled.
            {%- endcomment -%}
            {%- capture col_sizes -%}
							{%- if mobile == 2 -%}(max-width: 749px) calc(50vw - 15px), {%- else -%}(max-width: 749px) calc(100vw - 20px), {%- endif -%}
							{%- if per_row == 1 -%}calc(100vw - 10rem){%- elsif per_row == 2 -%}calc(50vw - 10rem){%- elsif per_row == 4 -%}calc(25vw - 10rem){%- else -%}calc(33vw - 10rem){%- endif -%}
						{%- endcapture -%}

            <div
              class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{- section.settings.image_ratio }} {%- if section.blocks.size == 1 %} single-block{% endif %}{% if video_overlay %} multicolumn-card__image-wrapper--video-overlay{% endif %}"
              {%- if video_overlay and block.settings.background_color != blank -%}
                style="background-color: {{ block.settings.background_color }};"
              {%- endif -%}
            >
              {%- if layout_type == 'badges' -%}
                {%- comment -%} Badges layout: small icon (uploaded image or built-in icon) {%- endcomment -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 112
                    | image_tag:
                      class: 'multicolumn-card__badge-icon',
                      loading: 'lazy',
                      width: 56,
                      height: 56,
                      alt: ''
                  }}
                {%- elsif block.settings.badge_icon != blank and block.settings.badge_icon != 'none' -%}
                  <img
                    class="multicolumn-card__badge-icon multicolumn-card__badge-icon--{{ block.settings.badge_icon }}"
                    src="{{ block.settings.badge_icon | prepend: 'icon-badge-' | append: '.svg' | asset_url }}"
                    alt=""
                    width="56"
                    height="56"
                    loading="lazy"
                  >
                {%- endif -%}
              {%- elsif video_overlay -%}
                {%- if block.settings.image != blank -%}
                  {%- assign height = block.settings.image.height -%}
                  {%- assign width = block.settings.image.width -%}
                  {%- capture style -%}object-fit: {{ section.settings.object_fit }};{%- endcapture -%}
                  {{
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag:
                      loading: 'lazy',
                      sizes: col_sizes,
                      widths: '360, 535, 600, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3800',
                      height: height,
                      width: width,
                      style: style
                  }}
                {%- endif -%}
                <div class="multicolumn-card__video-overlay-wrap">
                  {%- if block.settings.video != blank -%}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '800x',
                        autoplay: vid_autoplay,
                        loop: vid_loop,
                        muted: vid_mute,
                        playsinline: true,
                        controls: vid_controls,
                        class: 'multicolumn-card__video'
                    }}
                  {%- elsif block.settings.video_url != blank -%}
                    {%- if block.settings.video_url.type == 'youtube' -%}
                      <iframe
                        class="multicolumn-card__video multicolumn-card__video--iframe"
                        src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay={{ p_autoplay }}&mute={{ p_mute }}&loop={{ p_loop }}&controls={{ p_controls }}&playlist={{ block.settings.video_url.id }}&rel=0&modestbranding=1&enablejsapi=1"
                        allow="autoplay; encrypted-media; fullscreen"
                        allowfullscreen
                        title="{{ block.settings.heading | escape }}"
                      ></iframe>
                    {%- elsif block.settings.video_url.type == 'vimeo' -%}
                      <iframe
                        class="multicolumn-card__video multicolumn-card__video--iframe"
                        src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay={{ p_autoplay }}&muted={{ p_mute }}&loop={{ p_loop }}&controls={{ p_controls }}&background={{ p_mute }}"
                        allow="autoplay; encrypted-media; fullscreen"
                        allowfullscreen
                        title="{{ block.settings.heading | escape }}"
                      ></iframe>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- elsif block.settings.video != blank or block.settings.video_url != blank -%}
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '800x',
                      autoplay: vid_autoplay,
                      loop: vid_loop,
                      muted: vid_mute,
                      playsinline: true,
                      controls: vid_controls,
                      class: 'multicolumn-card__video',
                      style: 'object-fit: '
                    | append: section.settings.object_fit
                    | append: ';'
                  }}
                {%- elsif block.settings.video_url != blank -%}
                  {%- if block.settings.video_url.type == 'youtube' -%}
                    <iframe
                      class="multicolumn-card__video multicolumn-card__video--iframe"
                      src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay={{ p_autoplay }}&mute={{ p_mute }}&loop={{ p_loop }}&controls={{ p_controls }}&playlist={{ block.settings.video_url.id }}&rel=0&modestbranding=1&enablejsapi=1"
                      allow="autoplay; encrypted-media; fullscreen"
                      allowfullscreen
                      title="{{ block.settings.heading | escape }}"
                    ></iframe>
                  {%- elsif block.settings.video_url.type == 'vimeo' -%}
                    <iframe
                      class="multicolumn-card__video multicolumn-card__video--iframe"
                      src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay={{ p_autoplay }}&muted={{ p_mute }}&loop={{ p_loop }}&controls={{ p_controls }}&background={{ p_mute }}"
                      allow="autoplay; encrypted-media; fullscreen"
                      allowfullscreen
                      title="{{ block.settings.heading | escape }}"
                    ></iframe>
                  {%- endif -%}
                {%- endif -%}
              {%- elsif block.settings.image != blank -%}
                {%- assign height = block.settings.image.height -%}
                {%- assign width = block.settings.image.width -%}
                {%- capture style -%}object-fit: {{ section.settings.object_fit }};{%- endcapture -%}
                {{
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    loading: 'lazy',
                    sizes: col_sizes,
                    widths: '360, 535, 600, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3800',
                    height: height,
                    width: width,
                    style: style
                }}
              {%- else -%}
                {{ image_placeholder | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if block.settings.button_label != blank and layout_type == 'standard' -%}
                {% if section.settings.content_position != 'img-bottom' %}
                  <a
                    href="{{ block.settings.button_link }}"
                    class="multicolumn-card__link button button--simple button--arrow focus-inset"
                    {% if block.settings.button_link == blank %}
                      aria-disabled="true"
                    {% endif %}
                    aria-label="{{ block.settings.button_label | escape }}"
                  >
                    <span>
                      {{ block.settings.button_label | escape }}
                    </span>
                  </a>
                {% endif %}
                <div
                  class="multicolumn-card--standard-overlay"
                  style="background: rgba(0, 0, 0, {{ block.settings.overlay_opacity }})"
                ></div>
              {% endif %}
            </div>

            <div class="multicolumn-card__info">
              {% if block.settings.subheading != blank %}
                <p class="multicolumn-card__subheading subtitle">
                  {{ block.settings.subheading }}
                </p>
              {% endif %}
              {%- if block.settings.heading != blank -%}
                {% assign card_heading_tag = block.settings.card_heading_tag %}
                <{{ card_heading_tag }}
                  class="multicolumn-card__heading {{ section.settings.card_heading_size }}"
                  {% if block.settings.button_label != blank and block.settings.description == blank %}
                    style="margin-bottom: 0;"
                  {% endif %}
                >
                  {%- if is_column_linked -%}
                    <a href="{{ block.settings.column_link }}" class="multicolumn-card__heading-link">
                      {{- block.settings.heading | escape -}}
                    </a>
                  {%- else -%}
                    {{ block.settings.heading | escape }}
                  {%- endif -%}
                </{{ card_heading_tag }}>
              {%- endif -%}
              {% if block.settings.description != blank %}
                <div class="multicolumn-card__description">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                {% if layout_type == 'overlay' %}
                  <a
                    href="{{ block.settings.button_link }}"
                    class="multicolumn-card__link button button--simple button--arrow focus-inset button-inside-info"
                    {% if block.settings.button_link == blank %}
                      aria-disabled="true"
                    {% endif %}
                    aria-label="{{ block.settings.button_label | escape }}"
                  >
                    <span>
                      {{ block.settings.button_label | escape }}
                    </span>
                  </a>
                {% elsif layout_type == 'standard' and section.settings.content_position == 'img-bottom' %}
                  <a
                    href="{{ block.settings.button_link }}"
                    class="multicolumn-card__link button button--simple button--arrow focus-inset button-inside-info"
                    {% if block.settings.button_link == blank %}
                      aria-disabled="true"
                    {% endif %}
                    aria-label="{{ block.settings.button_label | escape }}"
                  >
                    <span>
                      {{ block.settings.button_label | escape }}
                    </span>
                  </a>
                {% endif %}
              {% endif %}
            </div>

            {%- comment -%} QA-17: no overlay link when the card has no link (it was an empty href that reloaded the page) {%- endcomment -%}
            {%- liquid
              if is_column_linked
                assign overlay_link = block.settings.column_link
              else
                assign overlay_link = block.settings.button_link
              endif
            -%}
            {%- if overlay_link != blank -%}
              <a
                href="{% if is_column_linked %}{{ block.settings.column_link }}{% else %}{{ block.settings.button_link }}{% endif %}"
                class="multicolumn__link-overlay{% if is_column_linked %} multicolumn__link-overlay--visual{% endif %}"
                aria-label="{{ block.settings.heading | escape }}"
                {% if is_column_linked %}
                  tabindex="-1"
                  aria-hidden="true"
                {% endif %}
                style="opacity: {{ block.settings.overlay_opacity }}"
              ></a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {% if navigation and swiper %}
        <div
          id="{{ section_id }}-cursor"
          class="cursor color-{{ section.settings.color_scheme }}"
        >
          <i
            id="{{ section_id }}-cursor-icon"
            class="cursor-icon button button--simple"
          ></i>
        </div>
        <div
          class="multicolumn__buttons multicolumn-button-prev "
          data-type="prev"
        >
          <button class="button button--simple">
            {% comment %}<span>{{ 'product-carousel.previous' | t }}</span>{% endcomment %}
          </button>
        </div>
        <div
          class="multicolumn__buttons multicolumn-button-next "
          data-type="next"
        >
          <button class="button button--simple">
            {% comment %}<span>{{ 'product-carousel.next' | t }}</span>{% endcomment %}
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "class": "spaced-section multicolumn-section",
  "tag": "section",
  "max_blocks": 12,
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-2",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.multicolumn.settings.heading.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.all.heading.tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "div",
          "label": "div"
        },
        {
          "value": "p",
          "label": "p"
        },
        {
          "value": "span",
          "label": "span"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.heading_layout.header.content"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.heading_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.multicolumn.settings.heading_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.heading_alignment.label"
    },
    {
      "type": "select",
      "id": "heading_content_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.multicolumn.settings.heading_content_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.multicolumn.settings.heading_content_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.heading_content_width.options__3.label"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.heading_content_width.label"
    },
    {
      "type": "checkbox",
      "id": "enable_full_screen",
      "default": true,
      "label": "t:sections.all.enable_full_screen.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.slider_options.header.content"
    },
    {
      "type": "checkbox",
      "id": "swiper",
      "label": "t:sections.multicolumn.settings.swiper.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stop_autoplay",
      "default": true,
      "label": "t:sections.all.slider_options.slider_hover_autoplay_stop.label"
    },
    {
      "type": "checkbox",
      "id": "navigation",
      "default": false,
      "label": "t:sections.all.slider_options.navigation.label"
    },
    {
      "type": "range",
      "id": "slideshow_speed",
      "min": 1,
      "max": 20,
      "step": 0.2,
      "default": 20,
      "unit": "s",
      "label": "t:sections.all.slider_options.speed.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.scroll_options.label",
      "visible_if": "{{ section.settings.swiper == false }}"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll",
      "label": "t:sections.multicolumn.settings.scroll_options.settings.enable_scroll.label",
      "info": "t:sections.multicolumn.settings.scroll_options.settings.enable_scroll.info",
      "default": false,
      "visible_if": "{{ section.settings.swiper == false }}"
    },
    {
      "type": "select",
      "id": "grid_space",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.grid_space.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.all.grid_space.options__2.label"
        },
        {
          "value": "none",
          "label": "t:sections.all.grid_space.options__3.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.grid_space.label",
      "info": "t:sections.multicolumn.settings.scroll_options.settings.enable_scroll.info",
      "visible_if": "{{ section.settings.swiper == false and section.settings.enable_scroll == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.card.header_card.content"
    },
    {
      "type": "select",
      "id": "layout_type",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.multicolumn.settings.layout_type.options__1.label"
        },
        {
          "value": "overlay",
          "label": "t:sections.multicolumn.settings.layout_type.options__2.label"
        },
        {
          "value": "badges",
          "label": "t:sections.multicolumn.settings.layout_type.options__3.label"
        }
      ],
      "default": "standard",
      "label": "t:sections.multicolumn.settings.layout_type.label"
    },
    {
      "type": "select",
      "id": "content_position",
      "info": "t:sections.multicolumn.settings.content_position.info",
      "options": [
        {
          "value": "img-top",
          "label": "t:sections.multicolumn.settings.content_position.options__1.label"
        },
        {
          "value": "img-bottom",
          "label": "t:sections.multicolumn.settings.content_position.options__2.label"
        }
      ],
      "default": "img-top",
      "label": "t:sections.multicolumn.settings.content_position.info"
    },
    {
      "type": "checkbox",
      "id": "always_visible_text",
      "default": false,
      "label": "t:sections.multicolumn.settings.always_visible_text.label",
      "info": "t:sections.multicolumn.settings.always_visible_text.info"
    },
    {
      "type": "select",
      "id": "on_hover",
      "label": "t:sections.multicolumn.settings.on_hover.label",
      "info": "t:sections.multicolumn.settings.on_hover.info",
      "options": [
        {
          "value": "hide_text",
          "label": "t:sections.multicolumn.settings.on_hover.options__1.label"
        },
        {
          "value": "show_text",
          "label": "t:sections.multicolumn.settings.on_hover.options__2.label"
        }
      ],
      "default": "show_text",
      "visible_if": "{{ section.settings.always_visible_text == false }}"
    },
    {
      "type": "range",
      "id": "multicolumn_to_show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.multicolumn_to_show.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio.options__2.label"
        },
        {
          "value": "square",
