{% doc %}
  Renders the quick add / quick view block of a product card.

  Extracted from `product-card` so the exact same markup can be regenerated when a
  linked product is selected in the product grid (see `product-card-linked-data`).

  @param {object} product_card_product - Product Liquid object
  @param {string} [section_id] - The ID of the section that contains the card
  @param {boolean} [show_color_count] - Whether the card shows color options (swatches let the customer pick a variant)
  @param {string} [button_label] - Always render the add to cart button with this label and a plus icon,
    independent of the global quick add setting; the button stays visible but disabled when sold out

  @example
  {% render 'product-card-quick-add', product_card_product: product, section_id: section.id, show_color_count: true %}
{% enddoc %}

{% if product_card_product.url != blank %}
  <div class="quick-add-block {% if settings.show_on_mobile %} quick-add-block--show{% endif %}">
    {% liquid
      assign quick_add = false
      if settings.add_to_cart_enabled
        assign quick_add = true
      endif

      assign quick_view = false
      if settings.quickview_show
        assign quick_view = true
      endif

      if settings.add_to_cart_enabled == false and settings.quickview_show == false and settings.show_on_mobile
        assign quick_add = true
        assign quick_view = true
        assign hide_desktop = true
      endif

      # Single color option products can only be added directly when the card renders swatches to pick the variant
      assign color_only_with_swatches = false
      if show_color_count and settings.type_color_swatch == 'custom' and settings.product_color_option_display == 'value' and product_card_product.options.size == 1 and product_card_product.options[0] == settings.trigger_swatch
        assign color_only_with_swatches = true
      endif

      assign can_quick_add = false
      if product_card_product.has_only_default_variant or color_only_with_swatches
        assign can_quick_add = true
      endif

      # A section-provided label always renders a button (disabled when sold out):
      # products without options add to cart directly, products with options open
      # the theme quick view popup so the customer can pick the variant first.
      assign show_add_to_cart = false
      if button_label != blank
        assign quick_add = true
        assign hide_desktop = false
        if can_quick_add
          assign show_add_to_cart = true
          assign quick_view = false
        else
          assign quick_view = true
        endif
      elsif quick_add and can_quick_add and product_card_product.selected_or_first_available_variant.available
        assign show_add_to_cart = true
      endif
    %}
    {%- if show_add_to_cart -%}
      {%- assign product_form_id = 'quick-add-' | append: section_id | append: product_card_product.id -%}
      <product-form
        class="card__add-to-cart card__button{% if button_label != blank %} card__add-to-cart--labelled{% endif %} {% if hide_desktop %} hide-desktop {% endif %}"
        data-source="{{ section.id }}"
      >
        {%- form 'product',
          product_card_product,
          id: product_form_id,
          class: 'form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            value="{{ product_card_product.selected_or_first_available_variant.id }}"
            disabled
          >
          <input
            type="hidden"
            name="product-url"
            value="{{ product_card_product.url }}"
            disabled
          >
          <button
            id="{{ product_form_id }}-submit"
            type="submit"
            class="
              card__link button
              button--simple
              {% if settings.show_on_mobile %} card__link--show{% endif %}
              card-focused
            "
            name="add"
            {% if button_label != blank %}
              aria-label="{{ button_label | escape }}: {{ product_card_product.title | escape }}"
            {% else %}
              aria-label="{{ 'general.card.quick__add' | t }}"
              aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
            {% endif %}
            aria-haspopup="dialog"
            aria-live="polite"
            data-sold-out-message="true"
            {% if product_card_product.selected_or_first_available_variant.available == false %}
              disabled
            {% endif %}
          >
            {% if button_label != blank %}
              <img
                class="card__add-to-cart-icon"
                src="{{ 'icon-plus-sample.svg' | asset_url }}"
                alt=""
                width="20"
                height="20"
                loading="lazy"
              >
              <span class="card__quickview-text">{{ button_label | escape }}</span>
            {% elsif settings.quickview_button_style != 'link'
              or settings.quickview_button_style_mobile != 'link'
            %}
              <span class="card__quickview-text">
                {{- 'general.card.quick__add' | t -}}
              </span>
            {% endif %}

            <span class="sold-out-message hidden">
              {{ 'products.product.sold_out' | t }}
            </span>
            <div class="loading-overlay__spinner hidden">
              <svg
                aria-hidden="true"
                focusable="false"
                role="presentation"
                class="spinner"
                viewBox="0 0 66 66"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
              </svg>
            </div>
          </button>
        {%- endform -%}
      </product-form>
    {%- elsif quick_view -%}
      <div class="quick-add no-js-hidden{% if button_label != blank %} card__add-to-cart--labelled{% endif %} {% if hide_desktop %} hide-desktop {% endif %}">
        {%- assign product_form_id = 'quick-add-' | append: section_id | append: product_card_product.id -%}
        <modal-opener data-modal="#QuickAdd-{{ product_card_product.id }}">
          <button
            id="{{ product_form_id }}-submit"
            type="submit"
            name="add"
            class="
              card__link button
              button--simple
              {% if settings.show_on_mobile %} card__link--show{% endif %}
              card-focused
            "
            {% if button_label != blank %}
              aria-label="{{ button_label | escape }}: {{ product_card_product.title | escape }}"
              {% if product_card_product.available == false %}
                disabled
              {% endif %}
            {% else %}
              aria-label="{{ 'general.card.quick__view' | t }}"
              aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
            {% endif %}
            aria-haspopup="dialog"
            data-product-url="{{ product_card_product.url }}"
          >
            {% if button_label != blank %}
              <img
                class="card__add-to-cart-icon"
                src="{{ 'icon-plus-sample.svg' | asset_url }}"
                alt=""
                width="20"
                height="20"
                loading="lazy"
              >
              <span class="card__quickview-text">{{ button_label | escape }}</span>
            {% elsif settings.quickview_button_style != 'link'
              or settings.quickview_button_style_mobile != 'link'
            %}
              <span class="card__quickview-text">
                {{- 'general.card.quick__view' | t -}}
              </span>
            {% endif %}

            <div class="loading-overlay__spinner hidden">
              <svg
                aria-hidden="true"
                focusable="false"
                role="presentation"
                class="spinner"
                viewBox="0 0 66 66"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
              </svg>
            </div>
          </button>
        </modal-opener>
        <quick-add-modal
          id="QuickAdd-{{ product_card_product.id }}"
          class="quick-add-modal"
        >
          <div
            role="dialog"
            aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
            aria-modal="true"
            class="quick-add-modal__content global-settings-popup"
          >
            <div class="quick-add-modal__header-wrapper h3">
              {% if product_card_product.title != blank %}
                <span class="quick-add-modal__header-text">
                  {{- product_card_product.title -}}
                </span>
              {% endif %}
              <button
                id="ModalClose-{{ product_card_product.id }}"
                type="button"
                class="quick-add-modal__toggle modal-close-button"
                aria-label="{{ 'accessibility.close' | t }}"
                tabindex="-1"
              >
                {% render 'icon-close' %}
              </button>
            </div>
            <div class="quick-add-modal__content-wrapper">
              <div
                id="QuickAddInfo-{{ product_card_product.id }}"
                class="quick-add-modal__content-info"
              ></div>
            </div>
          </div>
        </quick-add-modal>
      </div>
    {%- endif -%}
  </div>
{% endif %}
