{% comment %}
  Line icons for the Figma PDP (24 x 24, stroke = currentColor), drawn to match
  the Phosphor "regular" icons used in the design.

  Accepts:
  - icon: {String} star | hand | feather | size-rect | size-square | peel | glue |
          coverage | question | minus | plus | truck | caret-left | caret-right |
          caret-down | play | ruler | gear | trash | screwdriver | brush | warning
  - class: {String} optional class

  Usage:
  {% render 'pdp-figma-icon', icon: 'truck', class: 'pdp-figma__icon' %}
{% endcomment %}
{%- capture svg_open -%}
  <svg class="pdp-figma-icon {{ class }}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- endcapture -%}
{%- case icon -%}
  {%- when 'star' -%}
    <svg class="pdp-figma-icon {{ class }}" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.6l2.85 5.9 6.45.9-4.7 4.5 1.15 6.4L12 17.2l-5.75 3.1 1.15-6.4-4.7-4.5 6.45-.9z"/></svg>
  {%- when 'hand' -%}
    {{ svg_open }}<path d="M8.5 13V5.75a1.75 1.75 0 0 1 3.5 0V11"/><path d="M12 10V4.75a1.75 1.75 0 0 1 3.5 0V11"/><path d="M15.5 11V6.75a1.75 1.75 0 0 1 3.5 0V14a7 7 0 0 1-7 7h-.6a7 7 0 0 1-5.4-2.55L3.6 15.6a1.75 1.75 0 0 1 2.7-2.2L8.5 15.5"/></svg>
  {%- when 'feather' -%}
    {{ svg_open }}<path d="M20 4c-6 0-11 3.5-12.5 9.5L6 20"/><path d="M20 4c0 7-4 12-11.5 12.5"/><path d="M10.5 9.5H17"/><path d="M8.5 13H14"/></svg>
  {%- when 'size-rect' -%}
    {{ svg_open }}<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M12 4v16"/></svg>
  {%- when 'size-square' -%}
    {{ svg_open }}<rect x="4" y="4" width="16" height="16" rx="1"/></svg>
  {%- when 'peel' -%}
    {{ svg_open }}<path d="M14 20H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v9z"/><path d="M14 20v-5a1 1 0 0 1 1-1h5"/></svg>
  {%- when 'glue' -%}
    {{ svg_open }}<path d="M12 3c3 3.6 6 7.2 6 10.5a6 6 0 0 1-12 0C6 10.2 9 6.6 12 3z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/></svg>
  {%- when 'coverage' -%}
    {{ svg_open }}<rect x="3.5" y="3.5" width="11" height="11" rx="1"/><rect x="9.5" y="9.5" width="11" height="11" rx="1"/></svg>
  {%- when 'question' -%}
    {{ svg_open }}<circle cx="12" cy="12" r="9"/><path d="M9.75 9.5a2.25 2.25 0 1 1 3.1 2.08c-.5.2-.85.68-.85 1.22v.45"/><circle cx="12" cy="16.75" r=".6" fill="currentColor" stroke="none"/></svg>
  {%- when 'minus' -%}
    {{ svg_open }}<path d="M5 12h14"/></svg>
  {%- when 'plus' -%}
    {{ svg_open }}<path d="M5 12h14M12 5v14"/></svg>
  {%- when 'truck' -%}
    {{ svg_open }}<path d="M14.5 16.5V6.5H2.5v10h1.75"/><path d="M14.5 9.5h3.9l3.1 3.5v3.5h-1.75"/><path d="M8.25 16.5h7.5"/><circle cx="6.25" cy="16.75" r="2"/><circle cx="17.75" cy="16.75" r="2"/></svg>
  {%- when 'caret-left' -%}
    {{ svg_open }}<path d="M15 5l-7 7 7 7"/></svg>
  {%- when 'caret-right' -%}
    {{ svg_open }}<path d="M9 5l7 7-7 7"/></svg>
  {%- when 'caret-down' -%}
    {{ svg_open }}<path d="M5 9l7 7 7-7"/></svg>
  {%- when 'play' -%}
    <svg class="pdp-figma-icon {{ class }}" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7 4.5v15a.75.75 0 0 0 1.14.64l12.2-7.5a.75.75 0 0 0 0-1.28L8.14 3.86A.75.75 0 0 0 7 4.5z"/></svg>
  {%- when 'ruler' -%}
    {{ svg_open }}<path d="M3.4 15.9L15.9 3.4a1 1 0 0 1 1.4 0l3.3 3.3a1 1 0 0 1 0 1.4L8.1 20.6a1 1 0 0 1-1.4 0l-3.3-3.3a1 1 0 0 1 0-1.4z"/><path d="M7.5 11.5l2 2M10.5 8.5l2 2M13.5 5.5l2 2"/></svg>
  {%- when 'gear' -%}
    {{ svg_open }}<circle cx="12" cy="12" r="3.25"/><path d="M12 2.75l1.6 2.4 2.85-.55.55 2.85 2.4 1.6-1.25 2.95 1.25 2.95-2.4 1.6-.55 2.85-2.85-.55-1.6 2.4-1.6-2.4-2.85.55-.55-2.85-2.4-1.6L5.85 12 4.6 9.05l2.4-1.6.55-2.85 2.85.55z"/></svg>
  {%- when 'trash' -%}
    {{ svg_open }}<path d="M20 5.5H4"/><path d="M9.5 10v6.5M14.5 10v6.5"/><path d="M18.5 5.5V19a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1V5.5"/><path d="M15.5 5.5v-1.5a1.5 1.5 0 0 0-1.5-1.5h-4A1.5 1.5 0 0 0 8.5 4v1.5"/></svg>
  {%- when 'brush' -%}
    {{ svg_open }}<path d="M20.5 3.5c-3 1-8 5.5-10 8.5l1.5 1.5c3-2 7.5-7 8.5-10z"/><path d="M10.5 12c-2.5 0-4 1.75-4 4 0 1.5-1.25 2.75-3 3 1.25 1.25 3 1.5 4.75 1.5 2.75 0 4.25-2 4.25-4.25"/></svg>
  {%- when 'screwdriver' -%}
    {{ svg_open }}<path d="M14.5 9.5l-9 9"/><path d="M14 4.5l5.5 5.5-2.5 2.5-5.5-5.5z"/><path d="M4 20l1.5-1.5"/></svg>
  {%- when 'warning' -%}
    {{ svg_open }}<path d="M10.6 4.3L2.9 17.8A1.6 1.6 0 0 0 4.3 20.2h15.4a1.6 1.6 0 0 0 1.4-2.4L13.4 4.3a1.6 1.6 0 0 0-2.8 0z"/><path d="M12 9.5v4"/><circle cx="12" cy="16.75" r=".6" fill="currentColor" stroke="none"/></svg>
{%- endcase -%}
