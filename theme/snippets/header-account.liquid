{% liquid
  assign button_style = 'button--simple'
  if is_mobile == true
    assign button_type = 'text'
    assign button_style = 'button--tertiary'
  endif
%}

{%- if shop.customer_accounts_enabled and section.settings.enable_account_btn -%}
  {% render 'header-account-style' %}
  <div class="header__account{% if button_type == 'icon' %} header__account--icon{% endif %}">
    {% if section.settings.account_modal_type == 'shopify_based' %}
      <shopify-account
        menu="{{ section.settings.customer_account_menu | default: "customer-account-main-menu" }}"
        style="display: flex; align-items: center;"
      >
        <div slot="signed-out-avatar">
          <div class="header__button header__button--{{ button_type }} header__button--account button {{ button_style }}">
            {% if button_type == 'icon' %}
              {% render 'icon-account' %}
            {% elsif button_type == 'text' %}
              <div class="button__content header__icons">
                <span class="button__label header-label" data-label="{{- 'sections.header.account_label' | t -}}">
                  {{- 'sections.header.account_label' | t -}}
                </span>
              </div>
            {% else %}
              <div class="button__content header__icons header__icon">
                {% render 'icon-account' %}
                <span class="button__label header-label" data-label="{{- 'sections.header.account_label' | t -}}">
                  {{- 'sections.header.account_label' | t -}}
                </span>
              </div>
            {% endif %}
          </div>
        </div>
      </shopify-account>
    {%- else -%}
      {% liquid
        if customer
          assign btn_link = routes.account_profile_url
          assign btn_aria = 'customer.account_fallback' | t
        else
          assign btn_link = routes.account_login_url
          assign btn_aria = 'customer.log_in' | t
        endif
      %}
      <a
        href="{{ btn_link }}"
        class="header__button header__button--{{ button_type }} header__button--account focus-inset button {{ button_style }}"
        aria-label="{{- btn_aria -}}"
        role="button"
        {% if customer and customer.name != blank %}
          title="{{- 'sections.header.account_hover_text' | t: name: customer.name -}}"
        {% endif %}
      >
        {%- if button_type == 'icon' -%}
          {% render 'icon-account' %}
        {% elsif button_type == 'text' %}
          <div class="button__content">
            <span class="button__label header-label" data-label="{{- 'sections.header.account_label' | t -}}">
              {{- 'sections.header.account_label' | t -}}
            </span>
          </div>
        {%- else -%}
          <div class="button__content header__icon">
            {% render 'icon-account' %}
            <span class="button__label header-label" data-label="{{- 'sections.header.account_label' | t -}}">
              {{- 'sections.header.account_label' | t -}}
            </span>
          </div>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
