{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  - update_url: {Boolean} whether or not to update url when changing variants. If false, the url isn't updated. Default: true (optional).
  - section_id: {String}
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id, section_id: section_id %}
{% endcomment %}
{% liquid
  assign swatches_as_variant_image_already_shown = false
  assign is_featured_product = featured_product | default: false

  assign is_high_variant_product = false
  if product.variants_count > 250
    assign is_high_variant_product = true
  endif
%}

<div class="product-parameters {% if block.settings.picker_type == 'button' %}product-parameters-radius{% endif %}">
  {% comment %} Render linked products {% endcomment %}
  {%- if product != blank -%}
    {%- if block.settings.enable_linked_products -%}
      {% render 'product-linked-products', product_resource: product, block_obj: block %}
    {%- endif -%}
  {%- endif -%}
  {% comment %} Render variant picker {% endcomment %}

  {% unless product.has_only_default_variant %}
    {% if block.settings.picker_type == 'button' %}
      <variant-radios
        id="variant-radios-{{ section.id }}"
        class="no-js-hidden variant-radios {% if is_featured_product == true %}featured-product-radios{% endif %}"
        data-block="{{ section_id }}"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        {{ block.shopify_attributes }}
        data-variant-media-display="{{ section.settings.variant_media_display }}"
        data-scroll-to-variant-media="{{ section.settings.scroll_to_variant_media_mobile | default: false }}"
        data-is-high-variant-product="{{ is_high_variant_product }}"
      >
        {%- for option in product.options_with_values -%}
          {% liquid
            assign color_swatch = false
            assign option_name_first = ''
            assign color_trigger = settings.trigger_swatch | append: '<br />' | append: settings.trigger_swatch_other | strip | newline_to_br | split: '<br />'
            assign name_option = option.name | downcase | strip | replace: ' ', '-'
            assign option_name = option.name | escape | downcase | strip
            assign size_text = 'general.size' | t | downcase | strip
            assign color_text = 'general.color' | t | downcase | strip
            assign option_name_low = option.name | downcase | strip
            assign color_option_match_with_color_trigger = false

            for item in color_trigger
              assign item_temp = item | downcase | strip | replace: ' ', '-'
              if name_option == item_temp
                assign color_swatch = true
                assign option_name_first = item_temp
                assign color_option_match_with_color_trigger = true
              endif
            endfor

            assign is_variant_image_option = false
            if color_option_match_with_color_trigger and swatches_as_variant_image_already_shown == false
              assign is_variant_image_option = true
            endif
          %}

          <fieldset
            class="product-form__controls product-form__controls--{% if settings.type_color_swatch == 'custom' and color_swatch %}colors{% endif %}"
            id="SingleOptionSelector-{{ forloop.index0 }}"
            data-option-position="{{ option.position }}"
            {% if is_variant_image_option -%}
              data-is-variant-image-swatch="true"
            {%- endif %}
          >
            {% if block.settings.pill_group %}
              <div class="product-form__group-name subtitle">
                {{ option.name -}}
                {%- if color_swatch -%}
                  :
                  <span class="product-options-name" id="ColorName-{{ section.id }}"> {{ option.selected_value }}</span>
                {%- endif %}
              </div>
            {% endif %}
            <div class="product-form__controls-group">
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                option_name_first: option_name_first,
                option_name: option_name,
                notify_me: notify_me,
                prevent_variant_image: swatches_as_variant_image_already_shown
              %}

              {% liquid
                if color_option_match_with_color_trigger and swatches_as_variant_image_already_shown == false
                  assign swatches_as_variant_image_already_shown = true
                endif
              %}
            </div>

            {% if option_name == size_text and block.settings.show_size_guide %}
              <modal-opener
                class="no-js-hidden"
                data-modal="#PopupModal-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <button
                  class="button button--simple size-guide-btn"
                  id="ProductPopup-{{ block.id }}"
                  type="button"
                  aria-haspopup="dialog"
                  aria-label="Open popup"
                >
                  <span>{{ block.settings.size_guide_text }}</span>
                </button>
              </modal-opener>
              <modal-dialog
                id="PopupModal-{{ block.id }}"
                class="product-popup-modal size_guide_image_container"
                {{ block.shopify_attributes }}
              >
                <div
                  role="dialog"
                  aria-label="{{ block.settings.size_guide_text }}"
                  aria-modal="true"
                  class="product-popup-modal__content size_guide_modal"
                  tabindex="-1"
                >
                  <div class="product-popup-modal__top">
                    <button
                      id="ModalClose-{{ block.id }}"
                      type="button"
                      class="product-popup-modal__close modal-close-button focus-inset"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {% render 'icon-close' %}
                    </button>
                  </div>
                  <div class="product-popup-modal__content-info">
                    {%- if block.settings.size_guide_header != blank -%}
                      <h3 class="product-popup-modal__heading">
                        {{ block.settings.size_guide_header }}
                      </h3>
                    {%- endif -%}
                    {%- if block.settings.size_guide_description != blank -%}
                      <div class="product-popup-modal__text">
                        {{ block.settings.size_guide_description }}
                      </div>
                    {%- endif -%}
                    {% if block.settings.size_guide_image != blank and block.settings.show_size_guide %}
                      <div class="size_guide_image">
                        {{
                          block.settings.size_guide_image
                          | image_url: width: 1790
                          | image_tag: loading: 'lazy', widths: '553, 895, 1790'
                        }}
                      </div>
                    {% endif %}
                    {%- if block.settings.page.content != blank -%}
                      <div class="size_guide_content">
                        {{ block.settings.page.content }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </modal-dialog>
            {% endif %}
          </fieldset>
        {%- endfor -%}

        <script type="application/json" data-all-variants-no-high>
          {{ product.variants | json }}
        </script>

        <script type="application/json" data-selected-variant>
          {{ product.selected_or_first_available_variant | json }}
        </script>
      </variant-radios>
    {% else %}
      <variant-radios
        id="variant-radios-{{ section.id }}"
        class="no-js-hidden variant-selects {% if is_featured_product == true %}featured-product-radios{% endif %}"
        data-block="{{ section_id }}"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        {{ block.shopify_attributes }}
        data-variant-media-display="{{ section.settings.variant_media_display }}"
        data-scroll-to-variant-media="{{ section.settings.scroll_to_variant_media_mobile | default: false }}"
        data-is-high-variant-product="{{ is_high_variant_product }}"
        data-picker-type="{{ block.settings.picker_type }}"
      >
        {%- for option in product.options_with_values -%}
          {% liquid
            assign color_swatch = false
            assign color_trigger = settings.trigger_swatch | append: '<br />' | append: settings.trigger_swatch_other | strip | newline_to_br | split: '<br />'
            assign name_option = option.name | downcase | strip | replace: ' ', '-'
            assign option_name = option.name | escape | downcase
            assign size_text = 'general.size' | t | downcase
            assign color_option_match_with_color_trigger = false

            for item in color_trigger
              assign item_temp = item | downcase | strip | replace: ' ', '-'
              if name_option == item_temp
                assign color_swatch = true
                assign color_option_match_with_color_trigger = true
              endif
            endfor

            assign is_variant_image_option = false
            if color_option_match_with_color_trigger and swatches_as_variant_image_already_shown == false
              assign is_variant_image_option = true
            endif
          %}
          <fieldset
            class="product-form__controls product-form__controls--dropdown"
            data-option-position="{{ option.position }}"
            {% if is_variant_image_option -%}
              data-is-variant-image-swatch="true"
            {%- endif %}
          >
            <div class="select dropdown-select">
              <div class="select-label secondary_text">
                {{ option.name }}: <span>{{- option.selected_value }}</span>
              </div>
              <ul class="product-form__controls-group">
                {% render 'product-variant-options',
                  product: product,
                  option: option,
                  block: block,
                  notify_me: notify_me
                %}
              </ul>
              {% render 'icon-caret' %}
            </div>
            {% if option_name == size_text and block.settings.show_size_guide %}
              <modal-opener
                class="no-js-hidden"
                data-modal="#PopupModal-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <button
                  class="button button--simple size-guide-btn"
                  id="ProductPopup-{{ block.id }}"
                  type="button"
                  aria-haspopup="dialog"
                  aria-label="Open popup"
                >
                  <span>{{ block.settings.size_guide_text }}</span>
                </button>
              </modal-opener>
              <modal-dialog
                id="PopupModal-{{ block.id }}"
                class="product-popup-modal size_guide_image_container"
                {{ block.shopify_attributes }}
              >
                <div
                  role="dialog"
                  aria-label="{{ block.settings.size_guide_text }}"
                  aria-modal="true"
                  class="product-popup-modal__content size_guide_modal"
                  tabindex="-1"
                >
                  <div class="product-popup-modal__top">
                    <button
                      id="ModalClose-{{ block.id }}"
                      type="button"
                      class="product-popup-modal__close modal-close-button focus-inset"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {% render 'icon-close' %}
                    </button>
                  </div>
                  <div class="product-popup-modal__content-info">
                    {%- if block.settings.size_guide_header != blank -%}
                      <h3 class="product-popup-modal__heading">
                        {{ block.settings.size_guide_header }}
                      </h3>
                    {%- endif -%}
                    {%- if block.settings.size_guide_description != blank -%}
                      <div class="product-popup-modal__text">
                        {{ block.settings.size_guide_description }}
                      </div>
                    {%- endif -%}
                    {% if block.settings.size_guide_image != blank and block.settings.show_size_guide %}
                      <div class="size_guide_image">
                        {{
                          block.settings.size_guide_image
                          | image_url: width: 1790
                          | image_tag: loading: 'lazy', widths: '553, 895, 1790'
                        }}
                      </div>
                    {% endif %}
                    {%- if block.settings.page.content != blank -%}
                      <div class="size_guide_content">
                        {{ block.settings.page.content }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </modal-dialog>
            {% endif %}
          </fieldset>
        {% endfor %}

        <script type="application/json" data-all-variants-no-high>
          {{ product.variants | json }}
        </script>

        <script type="application/json" data-selected-variant>
          {{ product.selected_or_first_available_variant | json }}
        </script>
      </variant-radios>
    {% endif %}
  {% endunless %}

  <noscript
    class="product-form__noscript-wrapper-{{ section.id }}"
    data-variant-media-display="{{ section.settings.variant_media_display }}"
  >
    <fieldset
      class="product-form__controls {% if product.has_only_default_variant %} hidden{% endif %}"
      data-option-position="{{ option.position }}"
    >
      <label for="Variants-{{ section.id }}" class="product-form__group-name">
        {{- 'products.product.product_variants' | t -}}
        :</label
      >
      <div class="product-form__controls-group">
        <div class="select">
          <select
            name="id"
            id="Variants-{{ section.id }}"
            class="select__select"
            form="{{ product_form_id }}"
          >
            {%- for variant in product.variants -%}
              <option
                {% if variant == product.selected_or_first_available_variant %}
                  selected="selected"
                {% endif %}
                {% if variant.available == false %}
                  disabled
                {% endif %}
                value="{{ variant.id }}"
              >
                {%- liquid
                  echo variant.title
                  if settings.currency_code_enabled
                    echo variant.price | money_with_currency | strip_html | prepend: ' - '
                  else
                    echo variant.price | money | strip_html | prepend: ' - '
                  endif
                  if variant.available == false
                    echo 'products.product.sold_out' | t | prepend: ' - '
                  endif
                  if variant.quantity_rule.increment > 1
                    echo 'products.product.quantity.multiples_of' | t: quantity: variant.quantity_rule.increment | prepend: ' - '
                  endif
                  if variant.quantity_rule.min > 1
                    echo 'products.product.quantity.minimum_of' | t: quantity: variant.quantity_rule.min | prepend: ' - '
                  endif
                  if variant.quantity_rule.max != null
                    echo 'products.product.quantity.maximum_of' | t: quantity: variant.quantity_rule.max | prepend: ' - '
                  endif
                  assign cart_quantity = cart | item_count_for_variant: variant.id
                  if cart_quantity > 0
                    echo 'products.product.quantity.in_cart_html' | t: quantity: cart_quantity | prepend: ' - '
                  endif
                -%}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon-caret' %}
        </div>
      </div>
    </fieldset>
  </noscript>
</div>
