{% doc %}
  Renders the media (image or media slider) and badges of a product card.

  Extracted from `product-card` so the exact same markup can be regenerated when a
  linked product is selected in the product grid (see `product-card-linked-data`).

  @param {object} product_card_product - Product Liquid object
  @param {string} [media_size] - Image ratio of the card. Values are "landscape", "portrait" and "square"
  @param {string} [media_fit] - Image fit of the card. Values are "contain" and "cover"
  @param {number} [columns_mobile] - Number of columns on mobile. Default: 2
  @param {boolean} [show_slide] - Whether the media slider is allowed on this card. Default: true
  @param {string} [sale_badge_format] - "percent_off" renders the sale badge as "-20%". Default: theme setting
  @param {boolean} [room_view_media] - Collection "Products / Room" toggle: renders the product photo (2nd image,
    inset) and the room photo (1st image, full bleed); CSS shows one or the other. Default: false

  @example
  {% render 'product-card-media', product_card_product: product %}
{% enddoc %}

{%- liquid
  assign featured_media_aspect_ratio = product_card_product.featured_media.aspect_ratio

  if product_card_product.featured_media.aspect_ratio == null
    assign featured_media_aspect_ratio = 1
  endif

  assign mobile_columns = columns_mobile | default: 2

  assign render_slide = true
  if show_slide == false
    assign render_slide = false
  endif
-%}
{%- liquid
  # Room view: the store's first image is the room scene, the second the product photo.
  # Products without a second image use the first one for both.
  assign room_media = nil
  assign product_photo = nil
  if room_view_media
    assign card_images = product_card_product.media | where: 'media_type', 'image'
    assign room_media = card_images[0]
    assign product_photo = card_images[1] | default: card_images[0]
  endif
-%}
{% if room_view_media and room_media != nil %}
  <div class="media media--transparent media--{{ media_size }} card-room-media">
    {{
      product_photo
      | image_url: width: 1200
      | image_tag:
        loading: 'lazy',
        class: 'motion-reduce card-room-media__product',
        widths: '300, 450, 600, 800, 1000, 1200',
        sizes: '(min-width: 990px) calc((100vw - 2 * 8.33vw - 12rem) / 4 * 0.82), 34vw',
        alt: product_photo.alt | default: product_card_product.title
    }}
    {{
      room_media
      | image_url: width: 1600
      | image_tag:
        loading: 'lazy',
        class: 'motion-reduce card-room-media__room',
        widths: '360, 533, 720, 940, 1200, 1600',
        sizes: '(min-width: 990px) calc((100vw - 2 * 8.33vw - 12rem) / 4), 50vw',
        alt: room_media.alt | default: product_card_product.title
    }}
    <a
      href="{{ product_card_product.url | default: '#' }}"
      class="link link--overlay card-wrapper__link--overlay"
      aria-label="{{ 'accessibility.product_link' | t }}"
    ></a>
  </div>
{% elsif settings.on_hover == 'slider' and render_slide %}
  <div
    class="media media--transparent media--{{ media_size }} media--hover-effect"
    {%- if media_size == 'landscape' -%}
      style="padding-bottom: 65%;"
    {%- endif -%}
    {%- if media_size == 'portrait' -%}
      style="padding-bottom: 130%;"
    {%- endif -%}
    {%- if media_size == 'square' -%}
      style="padding-bottom: 100%;"
    {%- endif -%}
  >
    {%- if product_card_product.featured_media -%}
      {% assign width_ratio = 1 %}
      {% if product_card_product.featured_media.width < product_card_product.featured_media.height
        or media_size == 'landscape'
      %}
        {% assign width_ratio = 1 %}
      {% elsif product_card_product.featured_media.width > product_card_product.featured_media.height %}
        {% assign width_ratio = product_card_product.featured_media.width
          | plus: 0.0
          | divided_by: product_card_product.featured_media.height
          | round: 2
        %}
        {% if media_size == 'portrait' %}
          {% assign width_ratio = width_ratio | times: 1.3 %}
        {% endif %}
      {% endif %}

      {% capture sizes %}
					(min-width: 1100px) 535px * {{ width_ratio }}, (min-width: 750px) calc(((100vw - 130px) / 2) * {{ width_ratio }}), calc(((100vw - 50px) / {{ mobile_columns }}) * {{ width_ratio }})
				{% endcapture %}

      {% capture style %}
					{%- if media_fit == 'contain' -%}
						object-fit: contain;
					{%- endif -%}
					{%- if media_fit == 'cover' -%}
						object-fit: cover;
					{%- endif -%}
				{% endcapture %}
      <div
        class="swiper product-card-js"
        {% if settings.product_slider_limit_mobile_bullets %}
          data-mobile-bullets-limit="{{ settings.product_slider_mobile_bullets_count }}"
        {% endif %}
      >
        <div class="swiper-wrapper">
          <div class="swiper-slide media media--transparent media--{{ media_size }}">
            {{
              product_card_product.featured_media
              | image_url: width: product_card_product.featured_media.width
              | image_tag:
                loading: 'lazy',
                class: 'motion-reduce media--first',
                widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
                sizes: sizes,
                style: style
            }}
            <a
              href="{{ product_card_product.url | default: '#' }}"
              class="link link--overlay card-wrapper__link--overlay"
              aria-label="{{ 'accessibility.product_link' | t }}"
            ></a>
          </div>
          {% for img in product_card_product.media offset: 1 %}
            <div class="swiper-slide media media--transparent media--{{ media_size }}">
              {{
                img
                | image_url: width: img.width
                | image_tag:
                  loading: 'lazy',
                  class: 'motion-reduce media--second',
                  widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
                  sizes: sizes,
                  style: style
              }}
              <a
                href="{{ product_card_product.url | default: '#' }}"
                class="link link--overlay card-wrapper__link--overlay"
                aria-label="{{ 'accessibility.product_link' | t }}"
              ></a>
            </div>
          {% endfor %}
        </div>
        <div class="product-button-group button-prev">
          <div class="swiper-button-prev focus-inset">
            {% render 'icon-caret-left' %}
          </div>
        </div>
        <div class="product-button-group button-next">
          <div class="swiper-button-next focus-inset">
            {% render 'icon-caret-right' %}
          </div>
        </div>
        <div class="product-pagination">
          <div class="swiper-pagination"></div>
        </div>
      </div>
    {%- else -%}
      {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
{%- else -%}
  <div
    class="media media--transparent media--{{ media_size }} media--hover-effect"
    {%- if media_size == 'landscape' -%}
      style="padding-bottom: 65%;"
    {%- endif -%}
    {%- if media_size == 'portrait' -%}
      style="padding-bottom: 130%;"
    {%- endif -%}
    {%- if media_size == 'square' -%}
      style="padding-bottom: 100%;"
    {%- endif -%}
  >
    {%- if product_card_product.featured_media -%}
      {% assign width_ratio = 1 %}
      {% if product_card_product.featured_media.width < product_card_product.featured_media.height
        or media_size == 'landscape'
      %}
        {% assign width_ratio = 1 %}
      {% elsif product_card_product.featured_media.width > product_card_product.featured_media.height %}
        {% assign width_ratio = product_card_product.featured_media.width
          | plus: 0.0
          | divided_by: product_card_product.featured_media.height
          | round: 2
        %}
        {% if media_size == 'portrait' %}
          {% assign width_ratio = width_ratio | times: 1.3 %}
        {% endif %}
      {% endif %}

      {% capture sizes %}
					(min-width: 1100px) 535px * {{ width_ratio }}, (min-width: 750px) calc(((100vw - 130px) / 2) * {{ width_ratio }}), calc(((100vw - 50px) / {{ mobile_columns }}) * {{ width_ratio }})
				{% endcapture %}

      {% capture style %}
					{%- if media_fit == 'contain' -%}
						object-fit: contain;
					{%- endif -%}
					{%- if media_fit == 'cover' -%}
						object-fit: cover;
					{%- endif -%}
				{% endcapture %}

      {{
        product_card_product.featured_media
        | image_url: width: product_card_product.featured_media.width
        | image_tag:
          loading: 'lazy',
          class: 'motion-reduce media--first',
          widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
          sizes: sizes,
          style: style
      }}

      {%- if product_card_product.media[1] != null -%}
        {{
          product_card_product.media[1]
          | image_url: width: product_card_product.media[1].width
          | image_tag:
            loading: 'lazy',
            class: 'motion-reduce media--second',
            widths: '360, 533, 720, 940, 1066, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600',
            sizes: sizes,
            style: style
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
{%- endif -%}

{%- liquid
  # Sale badge values. With sale_badge_format "percent_off" (catalog cards) the "Sample"
  # variants are ignored, so a cheap sample does not turn into a huge discount badge.
  assign badge_price = product_card_product.price
  assign badge_compare = product_card_product.compare_at_price | default: 0
  if sale_badge_format == 'percent_off'
    assign badge_variant = nil
    for variant in product_card_product.variants
      assign is_sample = false
      for option_value in variant.options
        assign option_value_normalized = option_value | strip | downcase
        if option_value_normalized == 'sample'
          assign is_sample = true
        endif
      endfor
      unless is_sample
        if badge_variant == nil or variant.price < badge_variant.price
          assign badge_variant = variant
        endif
      endunless
    endfor
    if badge_variant != nil
      assign badge_price = badge_variant.price
      assign badge_compare = badge_variant.compare_at_price | default: 0
    endif
  endif
-%}

<div class="card__information-top subtitle badge-text-{{ settings.badge_custom_text_direction }}">
  {%- if settings.badge_sale_show or settings.badge_soldout_show or settings.badge_custom_show -%}
    <div class="card__badge">
      {%- if product_card_product.available == false and settings.badge_soldout_show -%}
        <span
          class="subtitle badge badge--soldout {% if settings.badges_background %} badge-transparent {% endif %}"
          aria-hidden="true"
        >
          {{- 'products.product.sold_out' | t -}}
        </span>
      {%- elsif badge_compare > badge_price
        and product_card_product.available
        and settings.badge_sale_show
      -%}
        <span
          class="subtitle badge badge--sale {% if settings.badges_background %} badge-transparent {% endif %}"
          aria-hidden="true"
        >
          {% if sale_badge_format == 'percent_off' %}
            {{- '-' -}}
            {{-
              badge_compare
              | minus: badge_price
              | times: 100
              | divided_by: badge_compare
            -}}
            {{- '%' -}}
          {% elsif settings.badge_sale_type == 'sale' %}
            {{- 'products.product.on_sale' | t -}}
          {% else %}
            {{- 'products.product.on_sale' | t -}}
            <span>
              {{
                badge_compare
                | minus: badge_price
                | times: 100
                | divided_by: badge_compare
              -}}
              %
            </span>
          {% endif %}
        </span>
      {%- endif -%}
      {% if settings.badge_custom_show and product_card_product.metafields.custom.badges != blank %}
        {% if product_card_product.metafields.custom.badges.list? %}
          {% for badge in product_card_product.metafields.custom.badges.value %}
            <span
              class="subtitle badge badge--custom {% if settings.badges_background %} badge-transparent {% endif %}"
              aria-hidden="true"
            >
              {{ badge }}
            </span>
          {% endfor %}
        {% else %}
          <span
            class="subtitle badge badge--custom {% if settings.badges_background %} badge-transparent {% endif %}"
            aria-hidden="true"
          >
            {{ product_card_product.metafields.custom.badges }}
          </span>
        {% endif %}
      {% endif %}
    </div>
  {%- endif -%}
</div>
