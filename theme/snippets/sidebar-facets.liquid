{% comment %}
		Renders facets (filtering and sorting)

		Accepts:
		- results: {Object} Collection or Search object
		- enable_filtering: {Boolean} Show filtering when true
		- enable_sorting: {Boolean} Show sorting when true

		Usage:
	{% render 'facets', results: collection, enable_filtering: true, enable_sorting: true %}
{% endcomment %}

{%- liquid
	assign sort_by = results.sort_by | default: results.default_sort_by
	if results.url
		assign results_url = results.url
	else
		assign terms = results.terms | escape
		assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
	endif

	if results.results_count
		assign res_count = results.results_count
	else
		assign res_count = results.products_count
	endif
-%}

<facet-filters-form class="facets facets_all {% if filter_tags == false %}facets-no-filter-tags{% endif %}">
	<form
		id="FacetFiltersFormSidebar"
		class="facets__form facets__form--vertical{% if filter_type == "horizontal" %} facets__form--horizontal{% endif %}"
	>
		{%- if results.terms -%}
			<input type="hidden" name="q" value="{{ results.terms | escape }}">
			<input dir="ltr" name="options[prefix]" type="hidden" value="last">
		{%- endif -%}

		{% if enable_filtering %}
			{% assign countFilters = results.filters | size %}
				<div
					id="FacetsWrapperDesktopSidebar"
					class="
						facets__wrapper facets__wrapper--vertical
						{% if filter_type == "horizontal" %} facets__wrapper--horizontal{% endif %}
					"
				>
					<div class="facets-modal__header">
						<div class="facets-modal__heading h3">
							{{ 'products.facets.filter_button' | t }}
							<span id="ProductCountSidebar">({{ res_count }})</span>
						</div>
						<button
							type="button"
							class="facets-modal__close focus-inset modal-close-button modal-sidebar-toggle-button focus-inset active"
							aria-label="{{ 'accessibility.close' | t }}"
						>
							<span class="icon icon-minus">
								{% render 'icon-minus' %}
							</span>
							<span class="icon icon-plus">
								{% render 'icon-plus' %}
							</span>
						</button>
					</div>

					{% render 'facets-filters',
						results: results,
						results_url: results_url,
						section_id: section.id,
						image_filter_columns: image_filter_columns,
						image_filter_ratio: image_filter_ratio,
						image_filter_fit: image_filter_fit,
						id_suffix: '-sidebar'
					%}
				</div>
		{% endif %}

		{% if results.current_vendor or results.current_type %}
			<input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
		{% endif %}
	</form>
</facet-filters-form>